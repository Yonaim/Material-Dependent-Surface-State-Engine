{
  "explorer.sortOrder": "filesFirst",
  "files.associations": {
    "*.vert": "glsl",
    "*.frag": "glsl",
    "*.comp": "glsl",
    "*.glsl": "glsl"
  },
  "maptz.regionfolder": {
    "[glsl]": {
      "foldStart": "// #region [NAME]",
      "foldStartRegex": "^[ \\t]*//[ \\t]*#region\\b[ \\t]*(.*?)[ \\t\\r]*$",
      "foldEnd": "// #endregion",
      "foldEndRegex": "^[ \\t]*//[ \\t]*#endregion\\b[ \\t\\r]*$",
      "disableFolding": false,
      "defaultFoldStartRegex": "^[ \\t]*//[ \\t]*#region\\b[ \\t]*(.*?)[ \\t\\r]*$"
    },
    "[shellscript]": {
      "foldStart": "#region [NAME]",
      "foldStartRegex": "^[ \\t]*#region\\b[ \\t]*(.*?)[ \\t\\r]*$",
      "foldEnd": "#endregion",
      "foldEndRegex": "^[ \\t]*#endregion\\b[ \\t\\r]*$",
      "disableFolding": false
    },
    "collapseDefaultRegionsOnOpen": true
  },
  "[glsl]": {
    "editor.foldingStrategy": "auto",
    "editor.folding": true,
    "editor.showFoldingControls": "always"
  },
  "foldOnOpen.targets": [
    "AllMarkerRegions"
  ]
}
