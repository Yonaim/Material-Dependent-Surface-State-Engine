{
  "maptz.regionfolder": {
    "[cpp]": {
      "foldStart": "#pragma region [NAME]",
      "foldEnd": "#pragma endregion",
      "foldStartRegex": "^\\s*#pragma[ \\t]+region[ \\t]+([^\\r\\n]+?)\\s*$",
      "foldEndRegex": "^\\s*#pragma[ \\t]+endregion\\b[^\\r\\n]*\\s*$"
    },
    "[glsl]": {
      "foldStart": "// #region [NAME]",
      "foldEnd": "// #endregion",
      "foldStartRegex": "^\\s*//[ \\t]*#region[ \\t]+([^\\r\\n]+?)\\s*$",
      "foldEndRegex": "^\\s*//[ \\t]*#endregion\\b[^\\r\\n]*\\s*$"
    }
  },
  "explorer.sortOrder": "filesFirst",
  "files.exclude": {
    ".gitignore": true,
    "AGENTS.md": true,
    "CHANGELOG.md": true,
    "README.md": true,
    "sortspec.md": true,
    ".obsidian": true,
    "Docs/*/.gitignore": true,
    "Docs/*/AGENTS.md": true,
    "Docs/*/CHANGELOG.md": true,
    "Docs/*/README.md": true,
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.log": true,
    "**/*.tmp": true,
    "**/*.bak": true,
    "**/*.swp": true,
    "**/*.swo": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/*.o": true,
    "**/*.obj": true,
    "**/*.a": true,
    "**/*.lib": true,
    "**/*.so": true,
    "**/*.dll": true,
    "**/*.dylib": true,
    "**/*.exe": true,
    "**/*.class": true,
    "**/*.pdb": true,
    "**/*.ilk": true,
    "**/*.pch": true,
    "**/*.ipch": true,
    "**/*.cache": true,
    "**/.obsidian": true,
    "**/00_Engineering-Standards/04_Docs_Templates": true,
    "**/sortspec.md": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/CMakeFiles": true,
    "**/build": true,
    "**/dist": true,
    "**/out": true,
    "**/bin": true,
    "**/obj": true,
    "**/Binaries": true,
    "**/Intermediate": true,
    "**/DerivedDataCache": true,
    "**/Saved": true,
    ".gitignore": true
  }
}
