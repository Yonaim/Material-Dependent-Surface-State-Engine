#version 450
#extension GL_GOOGLE_include_directive : require

#include "SurfaceSolverCommon.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint TexelIndex = gl_GlobalInvocationID.x;
    if (TexelIndex >= Solver.LocalTexelCount)
    {
        return;
    }

    for (uint ChannelIndex = 0u; ChannelIndex < Solver.StateChannelCount; ++ChannelIndex)
    {
        uint StateValueIndex = stateIndex(TexelIndex, ChannelIndex);
        if (!supportsChannel(TexelIndex, ChannelIndex))
        {
            OutgoingFluxScale.Values[StateValueIndex] = 0.0;
            continue;
        }

        float RawOutgoing = 0.0;
        for (uint DirectionIndex = 0u; DirectionIndex < SurfaceNeighborCount; ++DirectionIndex)
        {
            uint NeighborTexel = neighborIndex(TexelIndex, DirectionIndex);
            if (NeighborTexel == InvalidTexelIndex || NeighborTexel >= Solver.LocalTexelCount)
            {
                continue;
            }
            RawOutgoing += rawSaturationFlux(TexelIndex, NeighborTexel, ChannelIndex);
        }

        float Current = CurrentState.Values[StateValueIndex];
        float AvailableState = max(Current - decayAmount(TexelIndex, ChannelIndex), 0.0);
        OutgoingFluxScale.Values[StateValueIndex] = RawOutgoing > 0.0
            ? min(1.0, AvailableState / RawOutgoing)
            : 1.0;
    }
}
