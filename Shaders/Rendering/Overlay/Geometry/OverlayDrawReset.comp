// OverlayDrawReset.comp — overlay 경계 압축 전에 동적 indirect draw 개수를 초기화한다.
#version 450

// ============================================================
// 00. Resource Interface
// ============================================================
// #region 00_Resource_Interface
// CPU가 전달하는 리소스 선언과 shader의 접근 경계를 모아 ABI 대응을 확인한다.

layout(local_size_x = 64) in;

struct TDrawCommand
{
    uint VertexCount;
    uint InstanceCount;
    uint FirstVertex;
    uint FirstInstance;
};
struct TTopDrawCommand
{
    uint IndexCount;
    uint InstanceCount;
    uint FirstIndex;
    int VertexOffset;
    uint FirstInstance;
};
layout(set = 2, binding = 5, std430) buffer TDrawCommands
{
    TDrawCommand Values[];
}

DrawCommands;
layout(set = 2, binding = 6, std430) buffer TTopDrawCommands
{
    TTopDrawCommand Values[];
}

TopDrawCommands;

// #endregion

// ============================================================
// 01. Main Process
// ============================================================
// #region 01_Main_Process
// overlay 경계 압축 전에 동적 indirect draw 개수를 초기화한다.

void main()
{
    uint Index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;

    if (Index < uint(DrawCommands.Values.length()))
    {
        DrawCommands.Values[Index].VertexCount = 0u;
    }

    if (Index < uint(TopDrawCommands.Values.length()))
    {
        TopDrawCommands.Values[Index].IndexCount = 0u;
    }
}

// #endregion
