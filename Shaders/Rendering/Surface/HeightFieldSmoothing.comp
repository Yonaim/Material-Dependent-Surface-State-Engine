/**
 * @file HeightFieldSmoothing.comp
 * @brief chart와 profile 경계를 넘지 않도록 표시용 높이, cavity fill, normal을 완화한다.
 */
#version 450
#extension GL_GOOGLE_include_directive : require
#define SURFACE_DEBUG_SET 0
#include "Rendering/Surface/StateSampling.glsl"
#include "Debug/TexelGeometryData.glsl"

layout(local_size_x = 64) in;

layout(set = 1, binding = 0, std430) readonly buffer TInput { TTexelGeometryVertex Values[]; } InputGeometry;

layout(set = 2, binding = 0, std430) writeonly buffer TOutput { TTexelGeometryVertex Values[]; } OutputGeometry;
layout(set = 2, binding = 1, std430) readonly buffer TGeometryCache { uint Values[]; } GeometryCache;

layout(push_constant) uniform TPush
{
    uint TexelCount;
    uint Channel;
    uint Channels;
    uint Padding;
    float AccumulationDisplayScale;
    uint TileSize;
    uint UseSparse;
} Push;

const float CoverageCutoff = 0.02;

shared uint SparseTileValid;
shared uint SparseRangeFirst;
shared uint SparseRangeWidth;
shared uint SparseRangeHeight;
shared uint SparseTileX;
shared uint SparseTileY;

uint CapacityTileCount()
{
    return (Push.TexelCount + 255u) / 256u;
}

uint NormalListBase()
{
    // GeometryCache sparse layout matches TexelGeometry/OverlayOccupancyScan.
    return Push.TexelCount * 5u + CapacityTileCount() * 4u + 8u;
}

bool ResolveCandidateTile(uint Candidate)
{
    uint Base = 0u;
    for (uint Surface = 0u; Surface < uint(SurfaceRanges.Values.length()); ++Surface)
    {
        uvec4 Range = SurfaceRanges.Values[Surface];
        uint TilesX = Push.TileSize == 0u ? 0u : (Range.y + Push.TileSize - 1u) / Push.TileSize;
        uint TilesY = Push.TileSize == 0u ? 0u : (Range.z + Push.TileSize - 1u) / Push.TileSize;
        uint Count = TilesX * TilesY;
        if (Candidate < Base + Count)
        {
            uint Local = Candidate - Base;
            SparseTileValid = 1u;
            SparseRangeFirst = Range.x;
            SparseRangeWidth = Range.y;
            SparseRangeHeight = Range.z;
            SparseTileX = TilesX == 0u ? 0u : Local % TilesX;
            SparseTileY = TilesX == 0u ? 0u : Local / TilesX;
            return true;
        }
        Base += Count;
    }
    SparseTileValid = 0u;
    return false;
}

uint ResolveTexel()
{
    if (Push.UseSparse == 0u)
        return (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;

    uint TilePixels = max(Push.TileSize * Push.TileSize, 1u);
    uint GroupsPerTile = (TilePixels + gl_WorkGroupSize.x - 1u) / gl_WorkGroupSize.x;
    uint ActiveSlot = gl_WorkGroupID.x / GroupsPerTile;
    uint Subgroup = gl_WorkGroupID.x % GroupsPerTile;
    uint Candidate = GeometryCache.Values[NormalListBase() + ActiveSlot];

    if (gl_LocalInvocationIndex == 0u)
    {
        SparseTileValid = 0u;
        ResolveCandidateTile(Candidate);
    }
    barrier();
    if (SparseTileValid == 0u) return Push.TexelCount;

    uint Local = Subgroup * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (Local >= TilePixels) return Push.TexelCount;
    uint LocalX = Local % Push.TileSize;
    uint LocalY = Local / Push.TileSize;
    uint X = SparseTileX * Push.TileSize + LocalX;
    uint Y = SparseTileY * Push.TileSize + LocalY;
    if (X >= SparseRangeWidth || Y >= SparseRangeHeight) return Push.TexelCount;
    return SparseRangeFirst + Y * SparseRangeWidth + X;
}

float DisplayedCavityFill(uint Texel, uint Profile)
{
    if (Push.Channels == 0u || Push.Channel >= Push.Channels) return 0.0;
#if MDSS_GPU_VALIDATION
    if (Profile >= SurfaceProfileRecordCount() / Push.Channels) return 0.0;
#endif
    TSurfaceGPUProfileParameters Parameters = LoadSurfaceProfileParameters(Profile * Push.Channels + Push.Channel);
    float ReferenceAmount = StateSaturationForProfile(Texel, Push.Channel, Push.Channels, Profile) *
                            Parameters.CapacityInputAndTransfer.x;
    float CavityAmount = ReferenceAmount * Parameters.DecayAndGeometry.z * Parameters.DecayAndGeometry.w;
    return clamp(min(CavityAmount, 1.0) * Push.AccumulationDisplayScale, 0.0, 1.0);
}

void main()
{
    // 각 texel을 중심으로 한 3x3 이웃만 사용해 경계를 보존하며 smoothing한다.
    uint T = ResolveTexel();
    if (T >= Push.TexelCount) return;
#if MDSS_GPU_VALIDATION
    if (T >= uint(InputGeometry.Values.length())) return;
#endif
    TTexelGeometryVertex Original = InputGeometry.Values[T];
    OutputGeometry.Values[T] = Original;
#if MDSS_GPU_VALIDATION
    if (T >= uint(TexelSurfaceIndices.Values.length()) ||
        T >= uint(TexelProfileIndices.Values.length()) ||
        T >= uint(TexelChartIndices.Values.length()) ||
        T >= uint(GeometryScalars.Values.length()) ||
        T >= uint(Positions.Values.length()) || T >= uint(Normals.Values.length())) return;
#endif

    uint Surface = TexelSurfaceIndices.Values[T];
#if MDSS_GPU_VALIDATION
    if (Surface >= uint(SurfaceRanges.Values.length())) return;
#endif
    if (StateSaturation(T, Push.Channel, Push.Channels, Surface) <= CoverageCutoff) return;
    uvec4 Range = SurfaceRanges.Values[Surface];
    if (Range.y == 0u || Range.z == 0u || T < Range.x) return;
    uint Local = T - Range.x;
    if (Local >= Range.y * Range.z) return;
    ivec2 Center = ivec2(int(Local % Range.y), int(Local / Range.y));
    uint Chart = TexelChartIndices.Values[T];
    uint Profile = TexelProfileIndices.Values[T];
    float WeightedCavityFill = 0.0;
    float WeightedFollowingHeight = 0.0;
    vec3 WeightedNormal = vec3(0.0);
    float WeightSum = 0.0;
    for (int Y = -1; Y <= 1; ++Y)
    for (int X = -1; X <= 1; ++X)
    {
        ivec2 XY = Center + ivec2(X, Y);
        if (XY.x < 0 || XY.y < 0 || XY.x >= int(Range.y) || XY.y >= int(Range.z)) continue;
        uint N = Range.x + uint(XY.y) * Range.y + uint(XY.x);
        if (N >= Push.TexelCount) continue;
#if MDSS_GPU_VALIDATION
        if (N >= uint(InputGeometry.Values.length()) ||
            N >= uint(GeometryScalars.Values.length()) ||
            N >= uint(TexelSurfaceIndices.Values.length()) ||
            N >= uint(TexelProfileIndices.Values.length()) ||
            N >= uint(TexelChartIndices.Values.length())) continue;
#endif
        if (TexelSurfaceIndices.Values[N] != Surface ||
            TexelProfileIndices.Values[N] != Profile ||
            TexelChartIndices.Values[N] != Chart ||
            StateSaturationForProfile(N, Push.Channel, Push.Channels, Profile) <= CoverageCutoff) continue;

        float Meso = GeometryScalars.Values[N].MesoVirtualHeight;
#if MDSS_GPU_VALIDATION
        if (isnan(Meso) || isinf(Meso)) Meso = 0.0;
#endif
        float AccumulationHeight = InputGeometry.Values[N].HeightAndNormal.x - Meso;
#if MDSS_GPU_VALIDATION
        if (isnan(AccumulationHeight) || isinf(AccumulationHeight)) continue;
#endif
        float CavityDepth = max(-Meso, 0.0);
        float CavityFill = CavityDepth > 0.0 ? DisplayedCavityFill(N, Profile) : 0.0;
        float FollowingHeight = max(AccumulationHeight - CavityFill * CavityDepth, 0.0);
        float Weight = float((X == 0 ? 2 : 1) * (Y == 0 ? 2 : 1));
        WeightedCavityFill += Weight * CavityFill;
        WeightedFollowingHeight += Weight * FollowingHeight;
        WeightedNormal += Weight * InputGeometry.Values[N].HeightAndNormal.yzw;
        WeightSum += Weight;
    }
    if (WeightSum <= 0.0) return;
    float CenterMeso = GeometryScalars.Values[T].MesoVirtualHeight;
#if MDSS_GPU_VALIDATION
    if (isnan(CenterMeso) || isinf(CenterMeso)) CenterMeso = 0.0;
#endif
    float CenterCavityDepth = max(-CenterMeso, 0.0);
    float Height = CenterMeso + min(WeightedCavityFill / WeightSum, 1.0) * CenterCavityDepth +
                   WeightedFollowingHeight / WeightSum;
    OutputGeometry.Values[T].HeightAndNormal.x = Height;
    if (dot(WeightedNormal, WeightedNormal) > 1e-12)
        OutputGeometry.Values[T].HeightAndNormal.yzw = normalize(WeightedNormal);
}
