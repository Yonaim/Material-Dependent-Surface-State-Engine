/**
 * @file OverlaySideCoverage.comp
 * @brief overlay mesh 정점마다 활성 tile을 확인하고 해당 위치의 State coverage를 저장한다.
 */
#version 450
#extension GL_GOOGLE_include_directive : require
#include "Rendering/StateOverlay/OverlayStateSampling.glsl"
#include "Debug/TexelGeometryData.glsl"

layout(local_size_x = 64) in;

struct TOverlayVertex
{
    vec4 Position;
    vec4 Normal;
    vec4 UVSurface;
    vec4 DisplacementNormal;
    uvec4 Samples;
    vec4 Weights;
};

struct TDrawCommand
{
    uint VertexCount;
    uint InstanceCount;
    uint FirstVertex;
    uint FirstInstance;
};

struct TTopDrawCommand
{
    uint IndexCount;
    uint InstanceCount;
    uint FirstIndex;
    int VertexOffset;
    uint FirstInstance;
};

layout(set = 2, binding = 0, std430) readonly buffer TMeshVertices
{
    TOverlayVertex Values[];
} MeshVertices;

layout(set = 2, binding = 1, std430) readonly buffer TMeshIndices
{
    uint Values[];
} MeshIndices;

layout(set = 2, binding = 4, std430) buffer TCoverageValues
{
    uint Values[];
} Coverage;

layout(set = 2, binding = 5, std430) buffer TDrawCommands
{
    TDrawCommand Values[];
} DrawCommands;

layout(set = 2, binding = 6, std430) buffer TTopDrawCommands
{
    TTopDrawCommand Values[];
} TopDrawCommands;

layout(set = 1, binding = 1, std430) readonly buffer TGeometryCache
{
    uint Values[];
} GeometryCache;
layout(set = 1, binding = 0, std430) readonly buffer TComputedVertices
{
    TTexelGeometryVertex Values[];
} Computed;
layout(set = 0, binding = 4, std430) readonly buffer TOverlayGeometryScalars
{
    vec4 Values[];
} OverlayGeometryScalars;

layout(push_constant) uniform TOverlayPush
{
    uint Mud;
    uint WaterFilm;
    uint Lava;
    uint ActiveMaterialMask; // bit0 mud, bit1 water, bit2 lava
    uint Channel;
    uint Channels;
    uint TexelCount;
    uint TileSize;
    uint BoundaryCount;
    float HeightDisplayScale;
    uint UseOpaqueBase;
    uint Padding;
} Push;

uint CoverageListBase()
{
    uint Capacity = (uint(GeometryCache.Values.length()) - Push.TexelCount * 6u - 14u) / 7u;
    return Push.TexelCount * 6u + Capacity * 6u + 12u;
}

void ComputeCoverage(uint Index, bool TileActive)
{
    if (Index >= uint(MeshVertices.Values.length()) || Index >= uint(Coverage.Values.length())) return;
    if (!TileActive)
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
    TOverlayVertex Vertex = MeshVertices.Values[Index];
    uint Surface = uint(max(Vertex.UVSurface.w, 0.0));
    uint Channels = Push.Channels;
    uint Channel = Push.Channel;
    bool SharedSurface = Channel == 0xfffeu || Channel == 0xffffu;
    if (Channels == 0u || (!SharedSurface && Channel >= Channels))
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#if MDSS_GPU_VALIDATION
    if (Surface >= uint(OverlaySurfaceRanges.Values.length()))
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#endif
    uvec4 Range = OverlaySurfaceRanges.Values[Surface];
    if (Range.y == 0u || Range.z == 0u)
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
    vec2 UV = clamp(Vertex.UVSurface.xy, 0.0, 1.0);
    uvec2 CenterXY = min(uvec2(UV * vec2(Range.yz)), Range.yz - 1u);
    uint Center = Range.x + CenterXY.y * Range.y + CenterXY.x;
#if MDSS_GPU_VALIDATION
    if (Center >= uint(OverlayTexelProfileIndices.Values.length()) ||
        Center >= uint(OverlayTexelChartIndices.Values.length()))
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#endif
    uint Profile = OverlayTexelProfileIndices.Values[Center];
    uint Chart = OverlayTexelChartIndices.Values[Center];
    vec2 Pixel = UV * vec2(Range.yz) - 0.5;
    ivec2 Base = ivec2(floor(Pixel));
    vec2 F = fract(Pixel);
    float Value = 0.0;
    for (int Y = 0; Y < 2; ++Y)
    {
        for (int X = 0; X < 2; ++X)
        {
            ivec2 XY = clamp(Base + ivec2(X, Y), ivec2(0), ivec2(Range.yz) - 1);
            float Weight = (X == 0 ? 1.0 - F.x : F.x) * (Y == 0 ? 1.0 - F.y : F.y);
            uint Texel = Range.x + uint(XY.y) * Range.y + uint(XY.x);
#if MDSS_GPU_VALIDATION
            if (Texel >= uint(OverlayTexelProfileIndices.Values.length()) ||
                Texel >= uint(OverlayTexelChartIndices.Values.length())) continue;
#endif
            if (OverlayTexelProfileIndices.Values[Texel] != Profile ||
                OverlayTexelChartIndices.Values[Texel] != Chart) continue;
            if (SharedSurface)
            {
                float MaterialCoverage = 0.0;
                if ((Push.ActiveMaterialMask & 1u) != 0u && Push.Mud < Channels)
                    MaterialCoverage = max(MaterialCoverage,
                                           OverlayStateSaturation(Texel, Push.Mud, Channels, Profile));
                if ((Push.ActiveMaterialMask & 4u) != 0u && Push.Lava < Channels)
                    MaterialCoverage = max(MaterialCoverage,
                                           OverlayStateSaturation(Texel, Push.Lava, Channels, Profile));
                if (Channel == 0xffffu && (Push.ActiveMaterialMask & 2u) != 0u && Push.WaterFilm < Channels)
                    MaterialCoverage = max(MaterialCoverage,
                                           OverlayStateSaturation(Texel, Push.WaterFilm, Channels, Profile));
                Value += Weight * MaterialCoverage;
            }
            else
                Value += Weight * OverlayStateSaturation(Texel, Channel, Channels, Profile);
        }
    }
    if (SharedSurface)
    {
        float Top = 0.0;
        float Base = 0.0;
        for (uint K = 0u; K < 4u; ++K)
        {
            uint T = Vertex.Samples[K];
            if (Vertex.Weights[K] <= 0.0 || T >= uint(Computed.Values.length()) ||
                T >= uint(OverlayGeometryScalars.Values.length())) continue;
            Top += Vertex.Weights[K] * Computed.Values[T].HeightAndNormal.x;
            Base += Vertex.Weights[K] * OverlayGeometryScalars.Values[T].x;
        }
        Value = max(Value, Top - Base > 1.0e-6 ? 1.0 : 0.0);
    }
    Coverage.Values[Index] = floatBitsToUint(Value);
}

void main()
{
    if ((Push.Padding & 1u) != 0u || Push.TileSize == 0u)
    {
        uint Index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u +
                     gl_LocalInvocationID.x;
        ComputeCoverage(Index, true);
        return;
    }

    // One workgroup owns one dirty tile. The shared mesh's immutable CSR list maps that tile
    // to its vertices; only the per-instance coverage buffer is written.
    uint Slot = gl_WorkGroupID.x;
    uint Candidate = GeometryCache.Values[CoverageListBase() + Slot];
    uint TileCount = Push.Padding >> 1u;
    uint MappingBase = uint(MeshVertices.Values.length()) + uint(MeshIndices.Values.length());
    if (Candidate >= TileCount) return;
    bool TileActive = (GeometryCache.Values[Push.TexelCount * 4u + Candidate] & 1u) != 0u;
    uint Begin = Coverage.Values[MappingBase + Candidate];
    uint End = Coverage.Values[MappingBase + Candidate + 1u];
    for (uint Offset = Begin + gl_LocalInvocationID.x; Offset < End; Offset += gl_WorkGroupSize.x)
    {
        uint Vertex = Coverage.Values[MappingBase + Offset];
        ComputeCoverage(Vertex, TileActive);
    }
}
