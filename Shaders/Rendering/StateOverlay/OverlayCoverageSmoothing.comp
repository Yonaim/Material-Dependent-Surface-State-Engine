/**
 * @file OverlayCoverageSmoothing.comp
 * @brief overlay 정점 coverage를 주변 simulation texel에서 샘플해 부드럽게 만든다.
 */
#version 450
#extension GL_GOOGLE_include_directive : require
#include "Rendering/StateOverlay/OverlayStateSampling.glsl"

layout(local_size_x = 64) in;

#if MDSS_COVERAGE_HALO
shared uint HaloProfile[1296];
shared uint HaloChart[1296];
shared float HaloSaturation[1296];
shared uint HaloSurface;
shared uint HaloRangeFirst;
shared uint HaloRangeWidth;
shared uint HaloRangeHeight;
shared uint HaloTileX;
shared uint HaloTileY;
shared uint HaloTileValid;
#endif

struct TOverlayVertex
{
    vec4 Position;
    vec4 Normal;
    vec4 UVSurface;
    vec4 DisplacementNormal;
    uvec4 Samples;
    vec4 Weights;
};

struct TDrawCommand
{
    uint VertexCount;
    uint InstanceCount;
    uint FirstVertex;
    uint FirstInstance;
};

struct TTopDrawCommand
{
    uint IndexCount;
    uint InstanceCount;
    uint FirstIndex;
    int VertexOffset;
    uint FirstInstance;
};

layout(set = 2, binding = 0, std430) readonly buffer TMeshVertices
{
    TOverlayVertex Values[];
} MeshVertices;

layout(set = 2, binding = 1, std430) readonly buffer TMeshIndices
{
    uint Values[];
} MeshIndices;

layout(set = 2, binding = 4, std430) buffer TCoverageValues
{
    uint Values[];
} Coverage;

layout(set = 2, binding = 5, std430) buffer TDrawCommands
{
    TDrawCommand Values[];
} DrawCommands;

layout(set = 2, binding = 6, std430) buffer TTopDrawCommands
{
    TTopDrawCommand Values[];
} TopDrawCommands;

layout(set = 1, binding = 1, std430) readonly buffer TGeometryCache
{
    uint Values[];
} GeometryCache;

layout(push_constant) uniform TOverlayPush
{
    uint Mud;
    uint WaterFilm;
    uint Lava;
    uint ActiveMaterialMask;
    uint Channel;
    uint Channels;
    uint TexelCount;
    uint TileSize;
    uint BoundaryCount;
    float HeightDisplayScale;
    uint UseOpaqueBase;
    uint Padding;
} Push;


uint CoverageListBase()
{
    uint Capacity = (uint(GeometryCache.Values.length()) - Push.TexelCount * 6u - 14u) / 7u;
    return Push.TexelCount * 6u + Capacity * 6u + 12u;
}

#if MDSS_COVERAGE_HALO
float LoadCoverageSaturation(uint Texel, uint Profile)
{
    uint Channels = Push.Channels;
    uint Channel = Push.Channel;
    float Sample = 0.0;
    if (Channel == 0xfffeu || Channel == 0xffffu)
    {
        if ((Push.ActiveMaterialMask & 1u) != 0u && Push.Mud < Channels)
            Sample = max(Sample, OverlayStateSaturation(Texel, Push.Mud, Channels, Profile));
        if ((Push.ActiveMaterialMask & 4u) != 0u && Push.Lava < Channels)
            Sample = max(Sample, OverlayStateSaturation(Texel, Push.Lava, Channels, Profile));
        if (Channel == 0xffffu && (Push.ActiveMaterialMask & 2u) != 0u && Push.WaterFilm < Channels)
            Sample = max(Sample, OverlayStateSaturation(Texel, Push.WaterFilm, Channels, Profile));
    }
    else if (Channel < Channels)
        Sample = OverlayStateSaturation(Texel, Channel, Channels, Profile);
    return Sample;
}

void StageCoverageTile(uint Candidate)
{
    if (gl_LocalInvocationIndex == 0u)
    {
        HaloTileValid = 0u;
        uint Base = 0u;
        for (uint Surface = 0u; Surface < uint(OverlaySurfaceRanges.Values.length()); ++Surface)
        {
            uvec4 Range = OverlaySurfaceRanges.Values[Surface];
            uint TilesX = (Range.y + Push.TileSize - 1u) / Push.TileSize;
            uint TilesY = (Range.z + Push.TileSize - 1u) / Push.TileSize;
            if (Candidate < Base + TilesX * TilesY)
            {
                uint Local = Candidate - Base;
                HaloSurface = Surface;
                HaloRangeFirst = Range.x;
                HaloRangeWidth = Range.y;
                HaloRangeHeight = Range.z;
                HaloTileX = Local % TilesX;
                HaloTileY = Local / TilesX;
                HaloTileValid = 1u;
                break;
            }
            Base += TilesX * TilesY;
        }
    }
    barrier();
    if (HaloTileValid == 0u) return;
    uint Stride = Push.TileSize + 4u;
    for (uint Slot = gl_LocalInvocationIndex; Slot < Stride * Stride; Slot += 64u)
    {
        int X = int(HaloTileX * Push.TileSize + Slot % Stride) - 2;
        int Y = int(HaloTileY * Push.TileSize + Slot / Stride) - 2;
        bool Valid = X >= 0 && Y >= 0 && X < int(HaloRangeWidth) && Y < int(HaloRangeHeight);
        uint Texel = Valid ? HaloRangeFirst + uint(Y) * HaloRangeWidth + uint(X) : Push.TexelCount;
        Valid = Texel < Push.TexelCount && Texel < uint(OverlayTexelProfileIndices.Values.length()) &&
                Texel < uint(OverlayTexelChartIndices.Values.length()) &&
                Texel < uint(OverlayWorldTexelAreas.Values.length()) &&
                (Push.Channels == 0u || Texel < uint(OverlayCurrentState.Values.length()) / Push.Channels);
        uint Profile = Valid ? OverlayTexelProfileIndices.Values[Texel] : 0xffffffffu;
        Valid = Valid && Push.Channels > 0u && Profile < OverlayProfileRecordCount() / Push.Channels;
        HaloProfile[Slot] = Valid ? Profile : 0xffffffffu;
        HaloChart[Slot] = Valid ? OverlayTexelChartIndices.Values[Texel] : 0xffffffffu;
        HaloSaturation[Slot] = Valid ? LoadCoverageSaturation(Texel, Profile) : 0.0;
    }
    barrier();
}
#endif

void ComputeCoverage(uint Index, bool TileActive)
{
    if (Index >= uint(MeshVertices.Values.length()) || Index >= uint(Coverage.Values.length())) return;
    if (!TileActive)
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
    TOverlayVertex Vertex = MeshVertices.Values[Index];
    uint Surface = uint(max(Vertex.UVSurface.w, 0.0));
    uint Channels = Push.Channels;
    uint Channel = Push.Channel;
    uint TexelCount = Push.TexelCount;
    bool SharedSurface = Channel == 0xfffeu || Channel == 0xffffu;
    if (Channels == 0u || (!SharedSurface && Channel >= Channels))
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#if MDSS_GPU_VALIDATION
    if (Surface >= uint(OverlaySurfaceRanges.Values.length()))
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#endif

    uvec4 Range = OverlaySurfaceRanges.Values[Surface];
    if (Range.y == 0u || Range.z == 0u)
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }

    vec2 UV = clamp(Vertex.UVSurface.xy, 0.0, 1.0);
    uvec2 CenterXY = min(uvec2(UV * vec2(Range.yz)), Range.yz - 1u);
    uint Center = Range.x + CenterXY.y * Range.y + CenterXY.x;
    if (Center >= TexelCount)
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#if MDSS_GPU_VALIDATION
    if (Center >= uint(OverlayTexelProfileIndices.Values.length()) ||
        Center >= uint(OverlayTexelChartIndices.Values.length()))
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#endif
    uint Profile = OverlayTexelProfileIndices.Values[Center];
    uint Chart = OverlayTexelChartIndices.Values[Center];
#if MDSS_GPU_VALIDATION
    if (Profile >= OverlayProfileRecordCount() / Channels)
    {
        Coverage.Values[Index] = floatBitsToUint(0.0);
        return;
    }
#endif

    float Sum = 0.0;
    float WeightSum = 0.0;
    const int Kernel[5] = int[5](1, 4, 6, 4, 1);
#if MDSS_COVERAGE_HALO
    bool SharedTile = (Push.Padding & 1u) == 0u && HaloTileValid != 0u && Surface == HaloSurface;
#endif
    for (int OffsetY = -2; OffsetY <= 2; ++OffsetY)
    {
        int Y = int(CenterXY.y) + OffsetY;
        if (Y < 0 || Y >= int(Range.z)) continue;
        for (int OffsetX = -2; OffsetX <= 2; ++OffsetX)
        {
            int X = int(CenterXY.x) + OffsetX;
            if (X < 0 || X >= int(Range.y)) continue;
#if MDSS_COVERAGE_HALO
            if (SharedTile)
            {
                int LocalX = X - int(HaloTileX * Push.TileSize) + 2;
                int LocalY = Y - int(HaloTileY * Push.TileSize) + 2;
                int Stride = int(Push.TileSize) + 4;
                if (LocalX >= 0 && LocalY >= 0 && LocalX < Stride && LocalY < Stride)
                {
                    uint Slot = uint(LocalY * Stride + LocalX);
                    if (HaloProfile[Slot] != Profile || HaloChart[Slot] != Chart) continue;
                    float Weight = float(Kernel[OffsetX + 2] * Kernel[OffsetY + 2]);
                    Sum += Weight * HaloSaturation[Slot];
                    WeightSum += Weight;
                    continue;
                }
            }
#endif
            uint Texel = Range.x + uint(Y) * Range.y + uint(X);
            if (Texel >= TexelCount) continue;
#if MDSS_GPU_VALIDATION
            if (Texel >= uint(OverlayTexelProfileIndices.Values.length())) continue;
            if (Texel >= uint(OverlayTexelChartIndices.Values.length())) continue;
#endif
            if (OverlayTexelProfileIndices.Values[Texel] != Profile ||
                OverlayTexelChartIndices.Values[Texel] != Chart) continue;

            float Weight = float(Kernel[OffsetX + 2] * Kernel[OffsetY + 2]);
            float Sample = 0.0;
            if (SharedSurface)
            {
                if ((Push.ActiveMaterialMask & 1u) != 0u && Push.Mud < Channels)
                    Sample = max(Sample, OverlayStateSaturation(Texel, Push.Mud, Channels, Profile));
                if ((Push.ActiveMaterialMask & 4u) != 0u && Push.Lava < Channels)
                    Sample = max(Sample, OverlayStateSaturation(Texel, Push.Lava, Channels, Profile));
                if (Channel == 0xffffu && (Push.ActiveMaterialMask & 2u) != 0u && Push.WaterFilm < Channels)
                    Sample = max(Sample, OverlayStateSaturation(Texel, Push.WaterFilm, Channels, Profile));
            }
            else
            {
                Sample = OverlayStateSaturation(Texel, Channel, Channels, Profile);
            }
            Sum += Weight * Sample;
            WeightSum += Weight;
        }
    }
    Coverage.Values[Index] = floatBitsToUint(WeightSum > 0.0 ? clamp(Sum / WeightSum, 0.0, 1.0) : 0.0);
}

void main()
{
    if ((Push.Padding & 1u) != 0u || Push.TileSize == 0u)
    {
        uint Index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u +
                     gl_LocalInvocationID.x;
        ComputeCoverage(Index, true);
        return;
    }

    // One workgroup owns one dirty tile. The shared mesh's immutable CSR list maps that tile
    // to its vertices; only the per-instance coverage buffer is written.
    uint Slot = gl_WorkGroupID.x;
    uint Candidate = GeometryCache.Values[CoverageListBase() + Slot];
    uint TileCount = Push.Padding >> 1u;
    uint MappingBase = uint(MeshVertices.Values.length()) + uint(MeshIndices.Values.length());
    if (Candidate >= TileCount) return;
    bool TileActive = (GeometryCache.Values[Push.TexelCount * 4u + Candidate] & 1u) != 0u;
    uint Begin = Coverage.Values[MappingBase + Candidate];
    uint End = Coverage.Values[MappingBase + Candidate + 1u];
#if MDSS_COVERAGE_HALO
    if (TileActive) StageCoverageTile(Candidate);
#endif
    for (uint Offset = Begin + gl_LocalInvocationID.x; Offset < End; Offset += gl_WorkGroupSize.x)
    {
        uint Vertex = Coverage.Values[MappingBase + Offset];
        ComputeCoverage(Vertex, TileActive);
    }
}
