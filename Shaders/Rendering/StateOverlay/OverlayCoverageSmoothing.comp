/**
 * @file OverlayCoverageSmoothing.comp
 * @brief overlay 정점 coverage를 주변 simulation texel에서 샘플해 부드럽게 만든다.
 */
#version 450
#extension GL_GOOGLE_include_directive : require
#define SURFACE_DEBUG_SET 0
#include "Rendering/Surface/StateSampling.glsl"

layout(local_size_x = 64) in;

struct TOverlayVertex
{
    vec4 Position;
    vec4 Normal;
    vec4 UVSurface;
    vec4 DisplacementNormal;
    uvec4 Samples;
    vec4 Weights;
};

struct TDrawCommand
{
    uint VertexCount;
    uint InstanceCount;
    uint FirstVertex;
    uint FirstInstance;
};

struct TTopDrawCommand
{
    uint IndexCount;
    uint InstanceCount;
    uint FirstIndex;
    int VertexOffset;
    uint FirstInstance;
};

layout(set = 2, binding = 0, std430) readonly buffer TMeshVertices
{
    TOverlayVertex Values[];
} MeshVertices;

layout(set = 2, binding = 4, std430) writeonly buffer TCoverageValues
{
    float Values[];
} Coverage;

layout(set = 2, binding = 5, std430) buffer TDrawCommands
{
    TDrawCommand Values[];
} DrawCommands;

layout(set = 2, binding = 6, std430) buffer TTopDrawCommands
{
    TTopDrawCommand Values[];
} TopDrawCommands;

layout(set = 1, binding = 1, std430) readonly buffer TGeometryCache
{
    uint Values[];
} GeometryCache;

layout(push_constant) uniform TPush
{
    uint VertexCount;
    uint BoundaryCount;
    uint Channel;
    uint Channels;
    uint TexelCount;
    uint TileSize;
} Push;

bool IsTileActive(TOverlayVertex Vertex)
{
    if (Push.TileSize == 0u) return true;
    uint Surface = uint(max(Vertex.UVSurface.w, 0.0));
#if MDSS_GPU_VALIDATION
    if (Surface >= uint(SurfaceRanges.Values.length())) return false;
#endif
    uvec4 Range = SurfaceRanges.Values[Surface];
    if (Range.y == 0u || Range.z == 0u) return false;

    vec2 UV = clamp(Vertex.UVSurface.xy, 0.0, 1.0);
    uvec2 XY = min(uvec2(UV * vec2(Range.yz)), Range.yz - 1u);

    uint CandidateBase = 0u;
    for (uint S = 0u; S < Surface; ++S)
    {
        uvec4 Other = SurfaceRanges.Values[S];
        CandidateBase += ((Other.y + Push.TileSize - 1u) / Push.TileSize) *
                         ((Other.z + Push.TileSize - 1u) / Push.TileSize);
    }
    uint TilesX = (Range.y + Push.TileSize - 1u) / Push.TileSize;
    uint Candidate = CandidateBase + (XY.y / Push.TileSize) * TilesX + (XY.x / Push.TileSize);
    uint Flag = Push.TexelCount * 4u + Candidate;
#if MDSS_GPU_VALIDATION
    return Flag < uint(GeometryCache.Values.length()) && (GeometryCache.Values[Flag] & 1u) != 0u;
#else
    return (GeometryCache.Values[Flag] & 1u) != 0u;
#endif
}

void main()
{
    uint Index = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;

    // Reset only the dynamic indirect-command fields. Static index/offset data stays resident.
    if (Index < uint(DrawCommands.Values.length()))
        DrawCommands.Values[Index].VertexCount = 0u;
    if (Index < uint(TopDrawCommands.Values.length()))
        TopDrawCommands.Values[Index].InstanceCount = 0u;

    // 비활성 tile은 이전 실행값이 남지 않도록 정점 coverage를 0으로 초기화한다.
#if MDSS_GPU_VALIDATION
    if (GeometryCache.Values.length() == 0) return;
#endif
    if (GeometryCache.Values[uint(GeometryCache.Values.length()) - 1u] == 0u)
        return;

    if (Index >= Push.VertexCount) return;
#if MDSS_GPU_VALIDATION
    if (Index >= uint(MeshVertices.Values.length()) || Index >= uint(Coverage.Values.length())) return;
#endif

    TOverlayVertex Vertex = MeshVertices.Values[Index];
    if (!IsTileActive(Vertex))
    {
        Coverage.Values[Index] = 0.0;
        return;
    }

    uint Surface = uint(max(Vertex.UVSurface.w, 0.0));
    if (Push.Channels == 0u || Push.Channel >= Push.Channels)
    {
        Coverage.Values[Index] = 0.0;
        return;
    }
#if MDSS_GPU_VALIDATION
    if (Surface >= uint(SurfaceRanges.Values.length()))
    {
        Coverage.Values[Index] = 0.0;
        return;
    }
#endif

    uvec4 Range = SurfaceRanges.Values[Surface];
    if (Range.y == 0u || Range.z == 0u)
    {
        Coverage.Values[Index] = 0.0;
        return;
    }

    vec2 UV = clamp(Vertex.UVSurface.xy, 0.0, 1.0);
    uvec2 CenterXY = min(uvec2(UV * vec2(Range.yz)), Range.yz - 1u);
    uint Center = Range.x + CenterXY.y * Range.y + CenterXY.x;
    if (Center >= Push.TexelCount)
    {
        Coverage.Values[Index] = 0.0;
        return;
    }
#if MDSS_GPU_VALIDATION
    if (Center >= uint(NeighborIndices.Values.length()) ||
        Center >= uint(TexelSurfaceIndices.Values.length()) ||
        Center >= uint(TexelProfileIndices.Values.length()) || Center >= uint(TexelChartIndices.Values.length()))
    {
        Coverage.Values[Index] = 0.0;
        return;
    }
#endif
    if (TexelSurfaceIndices.Values[Center] != Surface)
    {
        Coverage.Values[Index] = 0.0;
        return;
    }

    uint Profile = TexelProfileIndices.Values[Center];
    uint Chart = TexelChartIndices.Values[Center];
#if MDSS_GPU_VALIDATION
    if (Profile >= uint(ProfileSupported.Values.length()) / Push.Channels ||
        Profile >= uint(ProfileParameters.Values.length()) / Push.Channels)
    {
        Coverage.Values[Index] = 0.0;
        return;
    }
#endif
    uint ProfileRecord = Profile * Push.Channels + Push.Channel;
    if (ProfileSupported.Values[ProfileRecord] == 0u)
    {
        Coverage.Values[Index] = 0.0;
        return;
    }

    float Sum = 0.0;
    float WeightSum = 0.0;
    const int Kernel[5] = int[5](1, 4, 6, 4, 1);
    for (int OffsetY = -2; OffsetY <= 2; ++OffsetY)
    {
        int Y = int(CenterXY.y) + OffsetY;
        if (Y < 0 || Y >= int(Range.z)) continue;
        for (int OffsetX = -2; OffsetX <= 2; ++OffsetX)
        {
            int X = int(CenterXY.x) + OffsetX;
            if (X < 0 || X >= int(Range.y)) continue;
            uint Texel = Range.x + uint(Y) * Range.y + uint(X);
            if (Texel >= Push.TexelCount) continue;
#if MDSS_GPU_VALIDATION
            if (Texel >= uint(TexelSurfaceIndices.Values.length()) ||
                Texel >= uint(TexelProfileIndices.Values.length()) || Texel >= uint(TexelChartIndices.Values.length()))
                continue;
#endif
            if (TexelSurfaceIndices.Values[Texel] != Surface ||
                TexelProfileIndices.Values[Texel] != Profile || TexelChartIndices.Values[Texel] != Chart)
                continue;

            float Weight = float(Kernel[OffsetX + 2] * Kernel[OffsetY + 2]);
            Sum += Weight * StateSaturationForProfile(Texel, Push.Channel, Push.Channels, Profile);
            WeightSum += Weight;
        }
    }
    Coverage.Values[Index] = WeightSum > 0.0 ? clamp(Sum / WeightSum, 0.0, 1.0) : 0.0;
}
