#version 450
#extension GL_GOOGLE_include_directive : require
#include "Debug/TexelGeometryData.glsl"

layout(local_size_x = 64) in;
struct TOverlayVertex
{
    vec4 Position;
    vec4 Normal;
    vec4 UVSurface;
    vec4 DisplacementNormal;
    uvec4 Samples;
    vec4 Weights;
};
struct TSideSegment
{
    vec4 BaseA;
    vec4 TopA;
    vec4 BaseB;
    vec4 TopB;
    vec4 Inside;
};
layout(set = 1, binding = 0, std430) readonly buffer TComputed
{
    TTexelGeometryVertex Values[];
} Computed;
layout(set = 2, binding = 0, std430) readonly buffer TMeshVertices
{
    TOverlayVertex Values[];
} MeshVertices;
layout(set = 2, binding = 3, std430) buffer TSegments
{
    TSideSegment Values[];
} Segments;
layout(push_constant) uniform TPush
{
    uint TriangleCount;
    uint BoundaryCount;
    uint Channel;
    uint Channels;
} Push;

struct TPoint
{
    vec3 Base;
    vec3 Top;
    vec2 UV;
};

TPoint ReadGeometryPoint(uint Index)
{
    TOverlayVertex V = MeshVertices.Values[Index];
    TPoint P;
    P.Base = V.Position.xyz;
    P.UV = V.UVSurface.xy;
    float Height = 0.0;
    for (uint K = 0u; K < 4u; ++K)
    {
        uint Texel = V.Samples[K];
        if (V.Weights[K] > 0.0 && Texel < uint(Computed.Values.length()))
            Height += V.Weights[K] * Computed.Values[Texel].PositionAndHeight.w;
    }
    P.Top = P.Base + V.DisplacementNormal.xyz * Height;
    return P;
}

TPoint Interpolate(TPoint A, TPoint B, float T)
{
    TPoint P;
    P.Base = mix(A.Base, B.Base, T);
    P.Top = mix(A.Top, B.Top, T);
    P.UV = mix(A.UV, B.UV, T);
    return P;
}

void WriteSegment(uint Slot, TPoint A, TPoint B, vec3 Inside, float Surface)
{
    Segments.Values[Slot].BaseA = vec4(A.Base, A.UV.x);
    Segments.Values[Slot].TopA = vec4(A.Top, A.UV.y);
    Segments.Values[Slot].BaseB = vec4(B.Base, B.UV.x);
    Segments.Values[Slot].TopB = vec4(B.Top, B.UV.y);
    Segments.Values[Slot].Inside = vec4(Inside, Surface);
}

void main()
{
    uint Slot = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;
    if (Slot >= Push.TriangleCount + Push.BoundaryCount) return;

    TSideSegment Plan = Segments.Values[Slot];
    uvec4 VertexIndices = floatBitsToUint(Plan.BaseA);
    uvec4 Metadata = floatBitsToUint(Plan.TopA);
    if (Metadata.x == 0u)
    {
        Segments.Values[Slot].Inside = vec4(0.0, 0.0, 0.0, -1.0);
        return;
    }

    vec2 Parameters = Plan.BaseB.xy;
    TPoint A;
    TPoint B;
    vec3 Inside;
    float Surface;
    if (Metadata.y == 0u)
    {
        TPoint P[3];
        P[0] = ReadGeometryPoint(VertexIndices.x);
        P[1] = ReadGeometryPoint(VertexIndices.y);
        P[2] = ReadGeometryPoint(VertexIndices.z);
        uint EdgeA = Metadata.z;
        uint EdgeB = Metadata.w;
        A = Interpolate(P[EdgeA], P[(EdgeA + 1u) % 3u], Parameters.x);
        B = Interpolate(P[EdgeB], P[(EdgeB + 1u) % 3u], Parameters.y);
        Inside = P[VertexIndices.w].Base;
        Surface = MeshVertices.Values[VertexIndices.x].UVSurface.w;
    }
    else
    {
        TPoint EdgeA = ReadGeometryPoint(VertexIndices.x);
        TPoint EdgeB = ReadGeometryPoint(VertexIndices.y);
        A = Interpolate(EdgeA, EdgeB, Parameters.x);
        B = Interpolate(EdgeA, EdgeB, Parameters.y);
        Inside = MeshVertices.Values[VertexIndices.z].Position.xyz;
        Surface = MeshVertices.Values[VertexIndices.x].UVSurface.w;
    }
    WriteSegment(Slot, A, B, Inside, Surface);
}
