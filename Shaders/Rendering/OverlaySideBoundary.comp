#version 450
#extension GL_GOOGLE_include_directive : require
#include "Debug/TexelGeometryData.glsl"
layout(local_size_x = 64) in;
shared uint ActiveTrianglesInGroup;

struct TOverlayVertex
{
    vec4 Position;
    vec4 Normal;
    vec4 UVSurface;
    vec4 DisplacementNormal;
    uvec4 Samples;
    vec4 Weights;
};
struct TSideSegment
{
    vec4 BaseA;
    vec4 TopA;
    vec4 BaseB;
    vec4 TopB;
    vec4 Inside;
};
struct TDrawCommand
{
    uint VertexCount;
    uint InstanceCount;
    uint FirstVertex;
    uint FirstInstance;
};
layout(set = 1, binding = 0, std430) readonly buffer TComputed
{
    TTexelGeometryVertex Values[];
} Computed;
layout(set = 1, binding = 1, std430) readonly buffer TGeometryCache
{
    uint Values[];
} GeometryCache;
layout(set = 2, binding = 0, std430) readonly buffer TMeshVertices
{
    TOverlayVertex Values[];
} MeshVertices;
layout(set = 2, binding = 1, std430) readonly buffer TMeshIndices
{
    uint Values[];
} MeshIndices;
layout(set = 2, binding = 2, std430) readonly buffer TBoundaryEdges
{
    uvec4 Values[];
} BoundaryEdges;
layout(set = 2, binding = 3, std430) writeonly buffer TSegments
{
    TSideSegment Values[];
} Segments;
layout(set = 2, binding = 4, std430) readonly buffer TCoverageValues
{
    float Values[];
} Coverage;
layout(set = 2, binding = 5, std430) buffer TDrawCommands
{
    TDrawCommand Values[];
} DrawCommands;
layout(push_constant) uniform TPush
{
    uint TriangleCount;
    uint BoundaryCount;
    uint Channel;
    uint Channels;
    uint TexelCount;
    uint TileSize;
} Push;

bool IsTileActive(uint Index)
{
    if (Index >= uint(MeshVertices.Values.length()) || Push.TileSize == 0u) return true;
    TOverlayVertex Vertex = MeshVertices.Values[Index];
    uint Texel = 0xffffffffu;
    for (uint K = 0u; K < 4u; ++K)
        if (Vertex.Weights[K] > 0.0) { Texel = Vertex.Samples[K]; break; }
    if (Texel == 0xffffffffu) return true;
    uint Tile = Texel / (Push.TileSize * Push.TileSize);
    uint Flag = Push.TexelCount * 4u + Tile;
    return Flag < uint(GeometryCache.Values.length()) && GeometryCache.Values[Flag] != 0u;
}

struct TPoint
{
    vec3 Base;
    vec3 Top;
    vec2 UV;
};

TPoint ReadGeometryPoint(uint Index)
{
    TOverlayVertex V = MeshVertices.Values[Index];
    TPoint P;
    P.Base = V.Position.xyz;
    P.UV = V.UVSurface.xy;
    float Height = 0.0;
    for (uint K = 0u; K < 4u; ++K)
    {
        uint Texel = V.Samples[K];
        if (V.Weights[K] > 0.0 && Texel < uint(Computed.Values.length()))
            Height += V.Weights[K] * Computed.Values[Texel].HeightAndNormal.x;
    }
    P.Top = P.Base + V.DisplacementNormal.xyz * Height;
    return P;
}

TPoint Interpolate(TPoint A, TPoint B, float T)
{
    TPoint P;
    P.Base = mix(A.Base, B.Base, T);
    P.Top = mix(A.Top, B.Top, T);
    P.UV = mix(A.UV, B.UV, T);
    return P;
}

void WriteSegment(uint Group, TPoint A, TPoint B, vec3 Inside, float Surface)
{
    uint LocalVertex = atomicAdd(DrawCommands.Values[Group].VertexCount, 6u);
    uint Segment = DrawCommands.Values[Group].FirstVertex / 6u + LocalVertex / 6u;
    Segments.Values[Segment].BaseA = vec4(A.Base, A.UV.x);
    Segments.Values[Segment].TopA = vec4(A.Top, A.UV.y);
    Segments.Values[Segment].BaseB = vec4(B.Base, B.UV.x);
    Segments.Values[Segment].TopB = vec4(B.Top, B.UV.y);
    Segments.Values[Segment].Inside = vec4(Inside, Surface);
}

void main()
{
    if (GeometryCache.Values[uint(GeometryCache.Values.length()) - 1u] == 0u) return;
    uint Slot = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;
    const float Cutoff = 0.02;
    if (gl_LocalInvocationIndex == 0u) ActiveTrianglesInGroup = 0u;
    barrier();

    uvec3 Indices = uvec3(0u);
    vec3 VertexCoverage = vec3(0.0);
    bool ValidTriangle = false;
    if (Slot < Push.TriangleCount)
    {
        uint Offset = Slot * 3u;
        if (Offset + 2u < uint(MeshIndices.Values.length()))
        {
            Indices = uvec3(MeshIndices.Values[Offset], MeshIndices.Values[Offset + 1u],
                            MeshIndices.Values[Offset + 2u]);
            ValidTriangle = Indices.x < uint(Coverage.Values.length()) &&
                            Indices.y < uint(Coverage.Values.length()) &&
                            Indices.z < uint(Coverage.Values.length());
            if (ValidTriangle)
            {
                if (!IsTileActive(Indices.x) && !IsTileActive(Indices.y) && !IsTileActive(Indices.z))
                    ValidTriangle = false;
            }
            if (ValidTriangle)
            {
                VertexCoverage = vec3(Coverage.Values[Indices.x], Coverage.Values[Indices.y],
                                      Coverage.Values[Indices.z]);
                if (any(greaterThan(VertexCoverage, vec3(Cutoff))))
                    atomicAdd(ActiveTrianglesInGroup, 1u);
            }
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && ActiveTrianglesInGroup != 0u)
        atomicAdd(DrawCommands.Values[uint(DrawCommands.Values.length()) - 1u].VertexCount,
                  ActiveTrianglesInGroup);
    if (Slot >= Push.TriangleCount + Push.BoundaryCount) return;

    if (Slot < Push.TriangleCount)
    {
        if (!ValidTriangle) return;
        uint CrossingEdges[2];
        float CrossingParameters[2];
        uint CrossingCount = 0u;
        uint InsideVertex = 0u;
        for (uint I = 0u; I < 3u; ++I)
        {
            uint J = (I + 1u) % 3u;
            bool A = VertexCoverage[I] > Cutoff;
            bool B = VertexCoverage[J] > Cutoff;
            if (A) InsideVertex = I;
            if (A != B && CrossingCount < 2u)
            {
                float Denominator = VertexCoverage[J] - VertexCoverage[I];
                CrossingEdges[CrossingCount] = I;
                CrossingParameters[CrossingCount] =
                    clamp((Cutoff - VertexCoverage[I]) / Denominator, 0.0, 1.0);
                ++CrossingCount;
            }
        }
        if (CrossingCount != 2u) return;
        uint Group = uint(MeshVertices.Values[Indices.x].UVSurface.w);
        if (Group + 2u >= uint(DrawCommands.Values.length())) return;
        TPoint P[3];
        P[0] = ReadGeometryPoint(Indices.x);
        P[1] = ReadGeometryPoint(Indices.y);
        P[2] = ReadGeometryPoint(Indices.z);
        uint EdgeA = CrossingEdges[0];
        uint EdgeB = CrossingEdges[1];
        TPoint A = Interpolate(P[EdgeA], P[(EdgeA + 1u) % 3u], CrossingParameters[0]);
        TPoint B = Interpolate(P[EdgeB], P[(EdgeB + 1u) % 3u], CrossingParameters[1]);
        WriteSegment(Group, A, B, P[InsideVertex].Base, MeshVertices.Values[Indices.x].UVSurface.w);
        return;
    }

    uvec4 Edge = BoundaryEdges.Values[Slot - Push.TriangleCount];
    if (Edge.x >= uint(Coverage.Values.length()) || Edge.y >= uint(Coverage.Values.length())) return;
    if (!IsTileActive(Edge.x) && !IsTileActive(Edge.y)) return;
    float CoverageA = Coverage.Values[Edge.x];
    float CoverageB = Coverage.Values[Edge.y];
    bool AActive = CoverageA > Cutoff;
    bool BActive = CoverageB > Cutoff;
    if (!AActive && !BActive) return;
    float ParameterA = 0.0;
    float ParameterB = 1.0;
    if (AActive != BActive)
    {
        float Crossing = clamp((Cutoff - CoverageA) / (CoverageB - CoverageA), 0.0, 1.0);
        if (AActive) ParameterB = Crossing;
        else ParameterA = Crossing;
    }
    TPoint EdgeA = ReadGeometryPoint(Edge.x);
    TPoint EdgeB = ReadGeometryPoint(Edge.y);
    TPoint A = Interpolate(EdgeA, EdgeB, ParameterA);
    TPoint B = Interpolate(EdgeA, EdgeB, ParameterB);
    WriteSegment(uint(DrawCommands.Values.length()) - 2u, A, B,
                 MeshVertices.Values[Edge.z].Position.xyz, MeshVertices.Values[Edge.x].UVSurface.w);
}
