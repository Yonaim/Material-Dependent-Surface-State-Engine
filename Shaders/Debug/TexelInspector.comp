// TexelInspector.comp — 선택한 texel과 channel의 누적량, 높이 분해, normal을 CPU 진단용 snapshot으로 복사한다.
#version 450
#extension GL_GOOGLE_include_directive : require
#define SURFACE_DEBUG_SET 0
#include "Debug/SurfaceDebugData.glsl"

// ============================================================
// 00. Resource Interface
// ============================================================
// #region 00_Resource_Interface
// CPU가 전달하는 리소스 선언과 shader의 접근 경계를 모아 ABI 대응을 확인한다.

layout(local_size_x = 1) in;

layout(push_constant) uniform TSelection
{
    uint Texel;
    uint Channel;
    uint Channels;
    float AccumulationDisplayScale;
    vec4 NormalMatrixColumns[3];
}

Selection;

layout(std430, set = 1, binding = 0) writeonly buffer TSnapshot
{
    vec4 Values[7];
}

Snapshot;
layout(std430, set = 0, binding = 23) readonly buffer TReactionTable
{
    uint Values[];
}

Reactions;
layout(std430, set = 0, binding = 24) readonly buffer TReactionScratch
{
    float Values[];
}

ReactionScratch;

void CaptureAccumulationDiagnostics();
void CaptureReactionDiagnostics();

// #endregion

// ============================================================
// 01. Main Process
// ============================================================
// #region 01_Main_Process
// 선택한 texel과 channel의 누적량, 높이 분해, normal을 CPU 진단용 snapshot으로 복사한다.

void main()
{
    CaptureAccumulationDiagnostics();
    CaptureReactionDiagnostics();
}
// #endregion

// ============================================================
// 02. Snapshot Capture Details
// ============================================================
// #region 02_Snapshot_Capture_Details
// 누적 형상과 반응 통계를 독립된 snapshot 슬롯에 기록한다.

    // 02.00. Accumulation and Normal
    // #region 02_00_Accumulation_and_Normal
    // 선택 texel의 누적 높이·구성 요소·노멀을 여섯 snapshot 슬롯에 기록한다.

    void CaptureAccumulationDiagnostics()
    {
        // snapshot은 고정된 여섯 vec4 슬롯에 계산 중간값을 묶어 기록한다.
        mat3 NormalMatrix = mat3(Selection.NormalMatrixColumns[0].xyz,
                                 Selection.NormalMatrixColumns[1].xyz,
                                 Selection.NormalMatrixColumns[2].xyz);
        TDebugAccumulation D = DebugAccumulation(
            Selection.Texel, Selection.Channel, Selection.Channels, Selection.AccumulationDisplayScale, NormalMatrix);
        Snapshot.Values[0] = vec4(D.State, D.Capacity, D.Saturation, D.ReferenceAmount);
        Snapshot.Values[1] = vec4(D.Factor, D.CavityFactor, D.MesoHeight, D.ThicknessPerAmount);
        Snapshot.Values[2] = vec4(D.CavityDepth, D.Fill, D.Excess, float(D.Status));
        Snapshot.Values[3] = vec4(D.CavityHeight, D.FollowingHeight, D.Height, D.MesoHeight + D.Height);
        Snapshot.Values[4] = vec4(D.Area, D.AreaScale, Selection.AccumulationDisplayScale, D.WorldToLocalHeight);
        vec3 Normal = vec3(0, 0, 1);

        if (D.Status == 3u && Selection.Texel < uint(MesoNormals.Values.length()))
        {
            Normal = DebugFinalNormal(
                Selection.Texel, Selection.Channel, Selection.Channels, Selection.AccumulationDisplayScale, NormalMatrix);
        }

        Snapshot.Values[5] = vec4(Normal, 0);

    }

    // #endregion

    // 02.01. Reaction Integration
    // #region 02_01_Reaction_Integration
    // 선택 채널의 reaction 적분 요약을 일곱 번째 snapshot 슬롯에 기록한다.

    void CaptureReactionDiagnostics()
    {
        Snapshot.Values[6] = vec4(0);

        if (Reactions.Values[1] > 0u)
        {
            uint At = Selection.Texel * (5u * Selection.Channels + Reactions.Values[1] + 4u) + 5u * Selection.Channels +
                      Reactions.Values[1];
            if (At + 3u < uint(ReactionScratch.Values.length()))
            {
                Snapshot.Values[6] = vec4(ReactionScratch.Values[At],
                                          ReactionScratch.Values[At + 1u],
                                          ReactionScratch.Values[At + 2u],
                                          ReactionScratch.Values[At + 3u]);
            }
        }

    }

    // #endregion

// #endregion
