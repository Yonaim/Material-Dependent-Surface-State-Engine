/**
 * @file TexelGeometry.comp
 * @brief 표시용 높이와 normal을 계산한다. Overlay sparse mode에서는 DirtyNormalTileList만 처리한다.
 */
#version 450
#extension GL_GOOGLE_include_directive : require
#define SURFACE_DEBUG_SET 0
#include "Debug/SurfaceDebugData.glsl"
#include "Debug/TexelGeometryData.glsl"

layout(local_size_x = 64) in;

layout(set = 1, binding = 0, std430) writeonly buffer TOutput { TTexelGeometryVertex Values[]; } Output;
layout(set = 1, binding = 1, std430) readonly buffer TGeometryCache { uint Values[]; } GeometryCache;

layout(push_constant) uniform TPush
{
    uint TexelCount;
    uint Channel;
    uint Channels;
    uint Accumulation;
    float AccumulationDisplayScale;
    float GeometryDisplayScale;
    uint TotalHeight;
    uint UseBaseline;
    uint TileSize;
    uint UseActiveTileList;
    uint Padding[2];
    vec4 NormalMatrixColumns[3];
} Push;

shared uint SparseTileValid;
shared uint SparseCandidate;
shared uint SparseRangeFirst;
shared uint SparseRangeWidth;
shared uint SparseRangeHeight;
shared uint SparseTileX;
shared uint SparseTileY;

uint CapacityTileCount()
{
    return (uint(GeometryCache.Values.length()) - Push.TexelCount * 6u - 14u) / 7u;
}

uint NormalListBase()
{
    // After the four texel planes:
    // flags[N], builtState[Texels], builtCoverage[Texels], three scheduled-flag planes,
    // heightCount, heightDispatch[3], heightList[N], normalCount, normalDispatch[3], normalList[N].
    return Push.TexelCount * 6u + CapacityTileCount() * 5u + 8u;
}

bool ResolveCandidateTile(uint Candidate)
{
    uint Base = 0u;
    for (uint Surface = 0u; Surface < uint(SurfaceRanges.Values.length()); ++Surface)
    {
        uvec4 Range = SurfaceRanges.Values[Surface];
        uint TilesX = Push.TileSize == 0u ? 0u : (Range.y + Push.TileSize - 1u) / Push.TileSize;
        uint TilesY = Push.TileSize == 0u ? 0u : (Range.z + Push.TileSize - 1u) / Push.TileSize;
        uint Count = TilesX * TilesY;
        if (Candidate < Base + Count)
        {
            uint Local = Candidate - Base;
            SparseTileValid = 1u;
            SparseCandidate = Candidate;
            SparseRangeFirst = Range.x;
            SparseRangeWidth = Range.y;
            SparseRangeHeight = Range.z;
            SparseTileX = TilesX == 0u ? 0u : Local % TilesX;
            SparseTileY = TilesX == 0u ? 0u : Local / TilesX;
            return true;
        }
        Base += Count;
    }
    SparseTileValid = 0u;
    return false;
}

uint ResolveTexel()
{
    if (Push.UseActiveTileList == 0u)
        return (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;

    uint TilePixels = max(Push.TileSize * Push.TileSize, 1u);
    uint GroupsPerTile = (TilePixels + gl_WorkGroupSize.x - 1u) / gl_WorkGroupSize.x;
    uint ActiveSlot = gl_WorkGroupID.x / GroupsPerTile;
    uint Subgroup = gl_WorkGroupID.x % GroupsPerTile;
    uint Candidate = GeometryCache.Values[NormalListBase() + ActiveSlot];

    if (gl_LocalInvocationIndex == 0u)
    {
        SparseTileValid = 0u;
        SparseCandidate = Candidate;
        ResolveCandidateTile(Candidate);
    }
    barrier();
    if (SparseTileValid == 0u) return Push.TexelCount;

    uint Local = Subgroup * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (Local >= TilePixels) return Push.TexelCount;
    uint LocalX = Local % Push.TileSize;
    uint LocalY = Local / Push.TileSize;
    uint X = SparseTileX * Push.TileSize + LocalX;
    uint Y = SparseTileY * Push.TileSize + LocalY;
    if (X >= SparseRangeWidth || Y >= SparseRangeHeight) return Push.TexelCount;
    return SparseRangeFirst + Y * SparseRangeWidth + X;
}

float DisplayHeight(uint Texel)
{
    if (Push.TotalHeight != 0u)
        return GeometryScalars.Values[Texel].MesoVirtualHeight +
               AccumulationHeights.Values[Texel] * Push.AccumulationDisplayScale;
    return uintBitsToFloat(GeometryCache.Values[Texel]);
}

vec3 CachedFinalNormal(uint Texel)
{
    vec3 Fallback = MesoNormals.Values[Texel].xyz;
    if (Texel >= Push.TexelCount || Texel >= uint(Positions.Values.length()) ||
        Texel >= uint(Normals.Values.length()) || Texel >= uint(NeighborIndices.Values.length())) return Fallback;
    float CenterHeight = DisplayHeight(Texel);
    if (isnan(CenterHeight)) return Fallback;
    // baseline cache도 Meso 높이에 같은 least-squares fitting을 적용해 만든 값이다.
    // TotalHeight는 이웃 제외 규칙이 다르므로 해당 cache를 재사용하지 않는다.
    if (Push.UseBaseline != 0u && Texel < Push.TexelCount &&
        Texel < uint(GeometryScalars.Values.length()) &&
        CenterHeight == GeometryScalars.Values[Texel].MesoVirtualHeight)
    {
        bool Unchanged = true;
        for (uint DirectionIndex = 0u; DirectionIndex < 8u; ++DirectionIndex)
        {
            uint Other = NeighborIndices.Values[Texel].Indices[DirectionIndex];
            if (Other >= Push.TexelCount) continue;
            if (Other >= uint(GeometryScalars.Values.length()))
            {
                Unchanged = false;
                break;
            }
            float NeighborHeight = DisplayHeight(Other);
            if (isnan(NeighborHeight) || NeighborHeight != GeometryScalars.Values[Other].MesoVirtualHeight)
            {
                Unchanged = false;
                break;
            }
        }
        if (Unchanged)
        {
            uint Offset = Push.TexelCount + Texel * 3u;
            return vec3(uintBitsToFloat(GeometryCache.Values[Offset]),
                        uintBitsToFloat(GeometryCache.Values[Offset + 1u]),
                        uintBitsToFloat(GeometryCache.Values[Offset + 2u]));
        }
    }
    vec3 N = normalize(Normals.Values[Texel].xyz);
    vec3 U = normalize(cross(abs(N.z) < 0.9 ? vec3(0,0,1) : vec3(0,1,0), N));
    vec3 V = cross(N, U);
    float XX = 0.0, XY = 0.0, YY = 0.0, XH = 0.0, YH = 0.0;
    for (uint DirectionIndex = 0u; DirectionIndex < 8u; ++DirectionIndex)
    {
        uint Other = NeighborIndices.Values[Texel].Indices[DirectionIndex];
        if (Other >= Push.TexelCount || Other >= uint(Positions.Values.length()) ||
            Other >= uint(Normals.Values.length()) || dot(N, Normals.Values[Other].xyz) < 0.5) continue;
        float NeighborHeight = DisplayHeight(Other);
        if (isnan(NeighborHeight)) continue;
        vec3 Delta = Positions.Values[Other].xyz - Positions.Values[Texel].xyz;
        float X = dot(Delta, U), Y = dot(Delta, V);
        float LengthSquared = X * X + Y * Y;
        if (LengthSquared <= 1e-16) continue;
        float Weight = 1.0 / LengthSquared;
        float DH = (NeighborHeight - CenterHeight) * Push.GeometryDisplayScale;
        XX += X * X * Weight; XY += X * Y * Weight; YY += Y * Y * Weight;
        XH += X * DH * Weight; YH += Y * DH * Weight;
    }
    float Det = XX * YY - XY * XY;
    if (Det <= 1e-6 * max(XX * YY, 1e-12)) return Fallback;
    vec2 Gradient = vec2(YY * XH - XY * YH, XX * YH - XY * XH) / Det;
    return normalize(N - U * Gradient.x - V * Gradient.y);
}

void main()
{
    uint T = ResolveTexel();
    if (T >= Push.TexelCount) return;

    uint TilePixels = max(Push.TileSize * Push.TileSize, 1u);
    uint TileFlag = 1u;
    if (Push.UseActiveTileList == 0u)
    {
        uint Tile = T / TilePixels;
        TileFlag = GeometryCache.Values[Push.TexelCount * 4u + Tile] & 1u;
        if (TileFlag == 0u)
        {
            // Legacy/full-dispatch path: inactive tiles still receive their baseline output.
            float BaseHeight = GeometryScalars.Values[T].MesoVirtualHeight;
            if (isnan(BaseHeight) || isinf(BaseHeight)) BaseHeight = 0.0;
            vec3 BaseNormal = MesoNormals.Values[T].xyz;
            if (any(isnan(BaseNormal)) || any(isinf(BaseNormal)) || dot(BaseNormal, BaseNormal) < 1e-12)
                BaseNormal = Normals.Values[T].xyz;
            Output.Values[T].HeightAndNormal = vec4(BaseHeight * Push.GeometryDisplayScale, normalize(BaseNormal));
            return;
        }
    }

    vec3 N = Normals.Values[T].xyz;
    float H = GeometryScalars.Values[T].MesoVirtualHeight;
    if (isnan(H) || isinf(H)) H = 0.0;
    vec3 FinalNormal = MesoNormals.Values[T].xyz;
    if (TexelSurfaceIndices.Values[T] != 0xffffffffu && Push.Accumulation != 0u)
    {
        float CachedHeight = DisplayHeight(T);
        if (!isnan(CachedHeight)) H = CachedHeight;
        // Sparse mode schedules a one-tile halo around dirty tiles. Even if this tile is currently inactive, recomputing
        // the normal lets an adjacent active tile bend the shared boundary continuously.
        FinalNormal = CachedFinalNormal(T);
    }
    if (any(isnan(FinalNormal)) || any(isinf(FinalNormal)) || dot(FinalNormal, FinalNormal) < 1e-12)
        FinalNormal = N;
    H *= Push.GeometryDisplayScale;
    if (isnan(H) || isinf(H)) H = 0.0;
    Output.Values[T].HeightAndNormal = vec4(H, normalize(FinalNormal));
}
