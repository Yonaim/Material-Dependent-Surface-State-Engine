/**
 * @file SurfaceDirtyDispatch.comp
 * @brief Skip geometry and weight dispatches when every height workgroup is unchanged.
 */
#version 450

// This buffer is also consumed by vkCmdDispatchIndirect. Declare it as uint
// here so the command words are written exactly, including small group counts.
layout(std430, set = 0, binding = 22) buffer TSurfaceAccumulationData
{
    uint Values[];
} AccumulationData;

layout(push_constant) uniform TSurfaceSolverPushConstants
{
    float DeltaTime;
    uint StateChannelCount;
    uint LocalTexelCount;
    uint Flags;
    vec4 GravityWorld;
    vec4 ModelLinearColumns[3];
    vec4 NormalMatrixAndUpColumns[3];
} Solver;

layout(local_size_x = 64) in;
shared uint AnyDirty[64];

void main()
{
    uint Lane = gl_LocalInvocationIndex;
    uint WorkgroupCount = (Solver.LocalTexelCount + 63u) / 64u;
    uint FlagBase = 3u * Solver.LocalTexelCount;
    uint Dirty = (Solver.Flags & (1u << 10u)) != 0u ? 1u : 0u;
    for (uint Group = Lane; Group < WorkgroupCount && Dirty == 0u; Group += 64u)
        Dirty |= AccumulationData.Values[FlagBase + Group] != 0u ? 1u : 0u;
    AnyDirty[Lane] = Dirty;
    barrier();
    for (uint Stride = 32u; Stride > 0u; Stride >>= 1u)
    {
        if (Lane < Stride) AnyDirty[Lane] |= AnyDirty[Lane + Stride];
        barrier();
    }
    if (Lane == 0u)
    {
        uint CommandBase = FlagBase + WorkgroupCount;
        AccumulationData.Values[CommandBase] = AnyDirty[0] != 0u ? WorkgroupCount : 0u;
        AccumulationData.Values[CommandBase + 1u] = 1u;
        AccumulationData.Values[CommandBase + 2u] = 1u;
    }
}
