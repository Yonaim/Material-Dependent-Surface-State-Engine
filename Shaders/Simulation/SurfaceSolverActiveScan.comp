/**
 * @file SurfaceSolverActiveScan.comp
 * @brief 현재/반대 ping-pong state와 input을 스캔해 Solver active workgroup + halo와 active channel mask를 만든다.
 */
#version 450

const uint InvalidTexelIndex = 0xffffffffu;
const uint SurfaceNeighborCount = 8u;
const uint SparseSolverFlag = 1u << 15u;
const uint ActiveChannelMaskFlag = 1u << 17u;

struct TSurfaceGPUNeighborIndices
{
    uint Indices[8];
};

layout(std430, set = 0, binding = 5) readonly buffer TSurfaceNeighborIndices
{
    TSurfaceGPUNeighborIndices Values[];
} NeighborIndices;

layout(std430, set = 0, binding = 8) readonly buffer TSurfaceCurrentState
{
    float Values[];
} CurrentState;

// Active scan에서는 ping-pong 반대쪽 버퍼도 읽는다. 두 버퍼가 모두 0이 될 때까지 한 step 더
// schedule해서 sparse solver가 stale state를 다음 swap에서 되살리지 않게 한다.
layout(std430, set = 0, binding = 9) readonly buffer TSurfacePreviousNextState
{
    float Values[];
} PreviousNextState;

layout(std430, set = 0, binding = 11) readonly buffer TSurfaceInputDelta
{
    float Values[];
} InputDelta;

layout(std430, set = 0, binding = 21) buffer TSurfaceAccumulationData
{
    uint Values[];
} AccumulationData;

layout(push_constant) uniform TSurfaceSolverPushConstants
{
    float DeltaTime;
    uint StateChannelCount;
    uint LocalTexelCount;
    uint Flags;
    vec4 GravityWorld;
    vec4 ModelLinearColumns[3];
    vec4 NormalMatrixAndUpColumns[3];
} Solver;

layout(local_size_x = 64) in;

uint WorkgroupCount() { return (Solver.LocalTexelCount + 63u) / 64u; }
uint SolverCommandBase() { return 3u * Solver.LocalTexelCount; }
uint SolverFlagBase() { return SolverCommandBase() + 3u; }
uint SolverListBase() { return SolverFlagBase() + WorkgroupCount(); }
uint ActiveChannelMaskIndex() { return SolverListBase() + WorkgroupCount(); }

void ScheduleGroup(uint Group)
{
    uint Groups = WorkgroupCount();
    if (Group >= Groups) return;
    if (atomicCompSwap(AccumulationData.Values[SolverFlagBase() + Group], 0u, 1u) == 0u)
    {
        uint Slot = atomicAdd(AccumulationData.Values[SolverCommandBase()], 1u);
        if (Slot < Groups)
            AccumulationData.Values[SolverListBase() + Slot] = Group;
    }
}

void main()
{
    uint Texel = gl_GlobalInvocationID.x;
    if (Texel >= Solver.LocalTexelCount) return;

    bool TexelActive = false;
    for (uint Channel = 0u; Channel < Solver.StateChannelCount; ++Channel)
    {
        uint Index = Texel * Solver.StateChannelCount + Channel;
        float Current = CurrentState.Values[Index];
        float PreviousNext = PreviousNextState.Values[Index];
        float Input = InputDelta.Values[Index];
        bool Active = Current != 0.0 || PreviousNext != 0.0 || Input != 0.0;
        if (!Active) continue;
        TexelActive = true;
        if ((Solver.Flags & ActiveChannelMaskFlag) != 0u && Channel < 32u)
            atomicOr(AccumulationData.Values[ActiveChannelMaskIndex()], 1u << Channel);
    }

    if (!TexelActive || (Solver.Flags & SparseSolverFlag) == 0u)
        return;

    ScheduleGroup(Texel / 64u);
    // Pass 2 gather target도 실행되어야 하므로 active source의 topology 1-hop group까지 포함한다.
    for (uint Direction = 0u; Direction < SurfaceNeighborCount; ++Direction)
    {
        uint Neighbor = NeighborIndices.Values[Texel].Indices[Direction];
        if (Neighbor != InvalidTexelIndex && Neighbor < Solver.LocalTexelCount)
            ScheduleGroup(Neighbor / 64u);
    }
}
