// SurfaceDynamicGeometryUpdate.comp — 현재 solver step의 누적 높이를 반영해 instance별 위치와 normal을 갱신한다.
#version 450
#extension GL_GOOGLE_include_directive : require
#define SURFACE_GEOMETRY_DIRTY_WRITE

#include "Simulation/Solver/SurfaceSolverCommon.glsl"

// ============================================================
// 00. Resource Interface
// ============================================================
// #region 00_Resource_Interface
// CPU가 전달하는 리소스 선언과 shader의 접근 경계를 모아 ABI 대응을 확인한다.

layout(local_size_x = 64) in;

const float DynamicGeometryEpsilon = 1.0e-6;

void ReadAndSanitizeDynamicGeometry(uint Texel, out vec3 Position, out vec3 Normal);
float MeasureWorldNeighborDistance(uint Texel, vec3 Position);

// #endregion

// ============================================================
// 01. Main Process
// ============================================================
// #region 01_Main_Process
// 현재 solver step의 누적 높이를 반영해 instance별 위치와 normal을 갱신한다.

void main()
{
    uint Texel = geometryOriginalGroup() * 64u + gl_LocalInvocationID.x;

    if (Texel >= Solver.LocalTexelCount)
    {
        return;
    }

    vec3 Position;
    vec3 Normal;
    ReadAndSanitizeDynamicGeometry(Texel, Position, Normal);
    float MeanDistance = MeasureWorldNeighborDistance(Texel, Position);

    uint PositionIndex = Texel * 2u;
    DynamicGeometry.Values[PositionIndex] = vec4(Position, MeanDistance);
    DynamicGeometry.Values[PositionIndex + 1u] = vec4(normalize(Normal), accumulationFloat(Texel));
}
// #endregion

// ============================================================
// 02. Detailed Implementation
// ============================================================
// #region 02_Detailed_Implementation
// 메인 스레드의 geometry 추출·복원·거리 측정 단계 구현을 모은다.

    // 02.00. Dynamic Position and Normal
    // #region 02_00_Dynamic_Position_and_Normal
    // 유효하지 않은 displacement 결과를 원본 geometry로 복구한다.

    void ReadAndSanitizeDynamicGeometry(uint Texel, out vec3 Position, out vec3 Normal)
    {
        // Height pass가 dependency halo를 workgroup 단위로 이미 compact했다. 여기서는 dispatched texel을
        // 그대로 갱신해 stale per-texel dirty flag를 다시 검사하는 비용과 sparse-height 세대 문제를 없앤다.
        Position = effectiveLocalPosition(Texel);
        Normal = effectiveLocalNormal(Texel);

        if (!solverFinite(Position))
        {
            Position =
                Positions.Values[Texel].xyz + Normals.Values[Texel].xyz * GeometryScalars.Values[Texel].MesoVirtualHeight;
        }

        if (!solverFinite(Normal) || dot(Normal, Normal) < 1.0e-12)
        {
            Normal = MesoNormals.Values[Texel].xyz;
        }
    }

    // #endregion

    // 02.01. World Neighbor Spacing
    // #region 02_01_World_Neighbor_Spacing
    // 동적 전송 거리 계산에 쓰이는 world-space 평균 이웃 거리를 측정한다.

    float MeasureWorldNeighborDistance(uint Texel, vec3 Position)
    {
        float MeanDistance = 0.0;

        if (isValidTexel(Texel) && (Solver.Flags & (1u << 7u)) != 0u)
        {
            mat3 ModelLinear =
                mat3(Solver.ModelLinearColumns[0].xyz, Solver.ModelLinearColumns[1].xyz, Solver.ModelLinearColumns[2].xyz);
            uint Count = 0u;

            for (uint DirectionIndex = 0u; DirectionIndex < SurfaceNeighborCount; ++DirectionIndex)
            {
                uint Neighbor = neighborIndex(Texel, DirectionIndex);

                if (Neighbor == InvalidTexelIndex || Neighbor >= Solver.LocalTexelCount || !isValidTexel(Neighbor))
                {
                    continue;
                }

                vec3 NeighborPosition = effectiveLocalPosition(Neighbor);

                if (!solverFinite(NeighborPosition))
                {
                    NeighborPosition = Positions.Values[Neighbor].xyz +
                                       Normals.Values[Neighbor].xyz * GeometryScalars.Values[Neighbor].MesoVirtualHeight;
                }

                float Distance = length(ModelLinear * (NeighborPosition - Position));

                if (solverFinite(Distance) && Distance > DynamicGeometryEpsilon)
                {
                    MeanDistance += Distance;
                    ++Count;
                }
            }

            if (Count > 0u)
            {
                MeanDistance /= float(Count);
            }
        }

        return MeanDistance;
    }

    // #endregion

// #endregion
