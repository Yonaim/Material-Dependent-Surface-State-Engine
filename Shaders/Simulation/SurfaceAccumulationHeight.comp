/**
 * @file SurfaceAccumulationHeight.comp
 * @brief 현재 descriptor의 State에서 누적 높이를 계산하고 geometry sparse schedule을 직접 생성한다.
 */
#version 450
#extension GL_GOOGLE_include_directive : require
#define SURFACE_ACCUMULATION_HEIGHT_WRITE
#include "Simulation/SurfaceSolver/SurfaceSolverCommon.glsl"

layout(local_size_x = 64) in;

const float DirtyHeightAbsoluteEpsilon = 1.0e-5;
const float DirtyHeightRelativeEpsilon = 1.0e-3;
const uint AccumulationGeometryUpdateFlag = 1u << 6u;
const uint ForceFullGeometryFlag = 1u << 10u;

void ScheduleGeometryGroup(uint Group)
{
    uint Groups = sparseWorkgroupCount();
    if (Group >= Groups) return;
    if (atomicCompSwap(AccumulationHeights.Values[geometryScheduleFlagBase() + Group], 0u, 1u) == 0u)
    {
        uint Slot = atomicAdd(AccumulationHeights.Values[geometryScheduleCommandBase()], 1u);
        if (Slot < Groups)
            AccumulationHeights.Values[geometryScheduleListBase() + Slot] = Group;
    }
}

void ScheduleGeometryTexelAndTwoHopNeighbors(uint Texel)
{
    if (Texel >= Solver.LocalTexelCount) return;
    ScheduleGeometryGroup(Texel / 64u);
    for (uint D = 0u; D < SurfaceNeighborCount; ++D)
    {
        uint N1 = neighborIndex(Texel, D);
        if (N1 == InvalidTexelIndex || N1 >= Solver.LocalTexelCount) continue;
        ScheduleGeometryGroup(N1 / 64u);
        for (uint D2 = 0u; D2 < SurfaceNeighborCount; ++D2)
        {
            uint N2 = neighborIndex(N1, D2);
            if (N2 != InvalidTexelIndex && N2 < Solver.LocalTexelCount)
                ScheduleGeometryGroup(N2 / 64u);
        }
    }
}

void main()
{
    uint OriginalGroup = accumulationOriginalGroup();
    uint Texel = OriginalGroup * 64u + gl_LocalInvocationID.x;
    if (Texel >= Solver.LocalTexelCount) return;

    bool GeometryFeedback = (Solver.Flags & AccumulationGeometryUpdateFlag) != 0u;
    bool ForceFull = (Solver.Flags & ForceFullGeometryFlag) != 0u;
    bool Dirty = false;

    if (!isValidTexel(Texel))
    {
        storeAccumulationFloat(Texel, 0.0);
        storeAccumulationFloat(Solver.LocalTexelCount + Texel, 0.0);
        return;
    }

    float Height = accumulationHeight(Texel);
    storeAccumulationFloat(Texel, Height);

    // 렌더 전용 height pass에서는 geometry dirty 판정을 위한 DynamicGeometry read조차 하지 않는다.
    if (!GeometryFeedback)
    {
        storeAccumulationFloat(Solver.LocalTexelCount + Texel, 0.0);
        return;
    }

    if (ForceFull)
    {
        // bootstrap은 C++에서 full Geometry/Weights dispatch를 직접 실행한다. 여기서는 height만 준비한다.
        storeAccumulationFloat(Solver.LocalTexelCount + Texel, 1.0);
        return;
    }

    float BuiltHeight = DynamicGeometry.Values[Texel * 2u + 1u].w;
    vec3 BuiltNormal = DynamicGeometry.Values[Texel * 2u + 1u].xyz;
    float HeightTolerance = max(DirtyHeightAbsoluteEpsilon,
                                DirtyHeightRelativeEpsilon * max(abs(Height), abs(BuiltHeight)));
    bool BuiltHeightInvalid = false;
    bool BuiltNormalInvalid = dot(BuiltNormal, BuiltNormal) < 0.5;
#if MDSS_GPU_VALIDATION
    BuiltHeightInvalid = isnan(BuiltHeight) || isinf(BuiltHeight);
    BuiltNormalInvalid = BuiltNormalInvalid || any(isnan(BuiltNormal)) || any(isinf(BuiltNormal));
#endif
    Dirty = BuiltHeightInvalid || abs(Height - BuiltHeight) > HeightTolerance || BuiltNormalInvalid;
    storeAccumulationFloat(Solver.LocalTexelCount + Texel, Dirty ? 1.0 : 0.0);
    if (!Dirty) return;

    if (useSparseSimulationGeometry())
    {
        // Geometry + transfer-weight dependency를 함께 만족하도록 기존과 동일한 topology 2-hop halo를 compact한다.
        ScheduleGeometryTexelAndTwoHopNeighbors(Texel);
    }
    else
    {
        // Legacy full geometry 경로도 별도 dirty-scan pass 없이 height shader가 indirect count를 직접 설정한다.
        atomicMax(AccumulationHeights.Values[geometryScheduleCommandBase()], sparseWorkgroupCount());
    }
}
