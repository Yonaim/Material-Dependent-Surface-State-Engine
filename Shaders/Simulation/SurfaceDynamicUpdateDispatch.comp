/**
 * @file SurfaceDynamicUpdateDispatch.comp
 * @brief dirty geometry workgroup을 선택적으로 compact해 geometry/weight indirect dispatch를 만든다.
 */
#version 450
#extension GL_GOOGLE_include_directive : require

#define SURFACE_DEBUG_SET 0
#include "Surface/SurfaceStateData.glsl"

// AccumulationHeights binding을 uint view로 사용한다. Height/dirty float와 command/list uint가 같은 buffer를 공유한다.
layout(std430, set = 0, binding = 21) buffer TSurfaceAccumulationData
{
    uint Values[];
} AccumulationData;

layout(push_constant) uniform TSurfaceSolverPushConstants
{
    float DeltaTime;
    uint StateChannelCount;
    uint LocalTexelCount;
    uint Flags;
    vec4 GravityWorld;
    vec4 ModelLinearColumns[3];
    vec4 NormalMatrixAndUpColumns[3];
} Solver;

layout(local_size_x = 64) in;

const uint InvalidTexelIndex = 0xffffffffu;
const uint SurfaceNeighborCount = 8u;
const uint SparseGeometryFlag = 1u << 13u;
const uint ForceFullGeometryFlag = 1u << 10u;

uint WorkgroupCount() { return (Solver.LocalTexelCount + 63u) / 64u; }
uint DirtyFlagBase() { return 3u * Solver.LocalTexelCount; }
uint CommandBase() { return DirtyFlagBase() + WorkgroupCount(); }
uint ScheduledFlagBase() { return CommandBase() + 3u; }
uint ScheduledListBase() { return ScheduledFlagBase() + WorkgroupCount(); }

bool HeightDirty(uint Texel)
{
    return Texel < Solver.LocalTexelCount &&
           AccumulationData.Values[Solver.LocalTexelCount + Texel] != 0u;
}

void ScheduleGroup(uint Group)
{
    uint Groups = WorkgroupCount();
    if (Group >= Groups) return;
    if (atomicCompSwap(AccumulationData.Values[ScheduledFlagBase() + Group], 0u, 1u) == 0u)
    {
        uint Slot = atomicAdd(AccumulationData.Values[CommandBase()], 1u);
        if (Slot < Groups)
            AccumulationData.Values[ScheduledListBase() + Slot] = Group;
    }
}

void ScheduleTexelAndTwoHopNeighbors(uint Texel)
{
    if (Texel >= Solver.LocalTexelCount) return;
    ScheduleGroup(Texel / 64u);
    for (uint D = 0u; D < SurfaceNeighborCount; ++D)
    {
        uint N1 = NeighborIndices.Values[Texel].Indices[D];
        if (N1 == InvalidTexelIndex || N1 >= Solver.LocalTexelCount) continue;
        ScheduleGroup(N1 / 64u);
        // Dynamic geometry marks direct neighbors dirty. Transfer weights also depend on neighbors
        // of those geometry-dirty texels, so schedule one more topology hop conservatively.
        for (uint D2 = 0u; D2 < SurfaceNeighborCount; ++D2)
        {
            uint N2 = NeighborIndices.Values[N1].Indices[D2];
            if (N2 != InvalidTexelIndex && N2 < Solver.LocalTexelCount)
                ScheduleGroup(N2 / 64u);
        }
    }
}

void main()
{
    uint Lane = gl_LocalInvocationIndex;
    uint Groups = WorkgroupCount();
    uint Cmd = CommandBase();

    // This pass is intentionally one workgroup so a single workgroup barrier is sufficient for
    // clearing the schedule metadata before any lane starts compacting.
    for (uint Group = Lane; Group < Groups; Group += 64u)
        AccumulationData.Values[ScheduledFlagBase() + Group] = 0u;
    if (Lane == 0u)
    {
        AccumulationData.Values[Cmd] = 0u;
        AccumulationData.Values[Cmd + 1u] = 1u;
        AccumulationData.Values[Cmd + 2u] = 1u;
    }
    barrier();

    bool Sparse = (Solver.Flags & SparseGeometryFlag) != 0u;
    bool ForceFull = (Solver.Flags & ForceFullGeometryFlag) != 0u;
    if (!Sparse)
    {
        uint AnyDirty = ForceFull ? 1u : 0u;
        for (uint Group = Lane; Group < Groups && AnyDirty == 0u; Group += 64u)
            AnyDirty |= AccumulationData.Values[DirtyFlagBase() + Group] != 0u ? 1u : 0u;
        if (AnyDirty != 0u) atomicOr(AccumulationData.Values[Cmd], 0x80000000u);
        barrier();
        if (Lane == 0u)
            AccumulationData.Values[Cmd] = (AccumulationData.Values[Cmd] & 0x80000000u) != 0u ? Groups : 0u;
        return;
    }

    if (ForceFull)
    {
        for (uint Group = Lane; Group < Groups; Group += 64u)
        {
            AccumulationData.Values[ScheduledFlagBase() + Group] = 1u;
            AccumulationData.Values[ScheduledListBase() + Group] = Group;
        }
        barrier();
        if (Lane == 0u) AccumulationData.Values[Cmd] = Groups;
        return;
    }

    // Scan only dirty workgroups; within them inspect the 64 height-dirty texels and compact all
    // workgroups that can affect geometry or transfer weights (self + topology 2-hop halo).
    for (uint Group = Lane; Group < Groups; Group += 64u)
    {
        if (AccumulationData.Values[DirtyFlagBase() + Group] == 0u) continue;
        uint First = Group * 64u;
        uint Last = min(First + 64u, Solver.LocalTexelCount);
        for (uint Texel = First; Texel < Last; ++Texel)
            if (HeightDirty(Texel)) ScheduleTexelAndTwoHopNeighbors(Texel);
    }
}
