#version 450
#extension GL_GOOGLE_include_directive : require
#include "Simulation/Solver/SurfaceSolverCommon.glsl"
#include "Simulation/Solver/ReactionBindings.glsl"
#include "Simulation/Solver/StateFinalize.glsl"
layout(local_size_x = 64) in;
shared uint GroupNextMask;

float rf(uint At) { return uintBitsToFloat(ReactionTable.Values[At]); }
float termCoefficient(uint R, uint Field, uint Channel)
{
    uint Offset = ReactionTable.Values[R + Field];
    uint Count = ReactionTable.Values[R + Field + 1u];
    for (uint T = 0u; T < Count; ++T)
        if (ReactionTable.Values[Offset + T * 2u] == Channel) return rf(Offset + T * 2u + 1u);
    return 0.0;
}
float reactionRequest(uint R, uint Base, uint ReadPlane, float Area, bool Inflow)
{
    uint K = Solver.StateChannelCount;
    bool IsInflow = ReactionTable.Values[R] == 1u;
    if (IsInflow != Inflow) return 0.0;
    uint State = ReactionTable.Values[R + (Inflow ? 7u : 2u)];
    float Request;
    if (Inflow)
    {
        uint Sources = ReactionTable.Values[R + 6u];
        float NewAmount = ((Sources & 1u) != 0u ? ReactionScratch.Values[Base + 3u*K + State] : 0.0) +
                          ((Sources & 2u) != 0u ? ReactionScratch.Values[Base + 4u*K + State] : 0.0);
        return NewAmount * rf(R + 5u) / termCoefficient(R, 8u, State);
    }
    uint Model = ReactionTable.Values[R + 1u];
    Request = rf(R + 4u) * Area;
    if (Model == 1u)
        Request = rf(R + 4u) * ReactionScratch.Values[Base + ReadPlane*K + State] / termCoefficient(R, 8u, State);
    if (Model == 2u)
    {
        uint Offset = ReactionTable.Values[R + 14u];
        for (uint F = 0u; F < ReactionTable.Values[R + 15u]; ++F)
        {
            uint At = Offset + F*3u;
            float X = ReactionScratch.Values[Base + ReadPlane*K + ReactionTable.Values[At]];
            Request *= pow(max(X / (Area * rf(At+1u)), 0.0), rf(At+2u));
        }
    }
    uint Offset = ReactionTable.Values[R + 12u];
    for (uint M = 0u; M < ReactionTable.Values[R + 13u]; ++M)
    {
        uint At = Offset + M*4u;
        float X = ReactionScratch.Values[Base + ReadPlane*K + ReactionTable.Values[At]];
        float Threshold = Area * rf(At+2u);
        float Scale = Area * rf(At+3u);
        uint Function = ReactionTable.Values[At+1u];
        float Multiplier = Function == 0u ? (X >= Threshold ? 1.0 : 0.0) :
                           Function == 1u ? (X <= Threshold ? 1.0 : 0.0) :
                           Function == 2u ? max(0.0, (X-Threshold)/Scale) :
                           Function == 3u ? max(0.0, (Threshold-X)/Scale) :
                           Function == 4u ? X/Scale : 1.0/(1.0+X/Scale);
        Request *= Multiplier;
    }
    return Request;
}

void main()
{
    uint Group = solverOriginalGroup();
    uint Texel = Group*64u + gl_LocalInvocationID.x;
    if (gl_LocalInvocationIndex == 0u) GroupNextMask = 0u;
    barrier();
    uint Mask = 0u;
    bool NeedsNext = false;
    if (Texel < Solver.LocalTexelCount)
    {
        uint K = Solver.StateChannelCount;
        uint Base = reactionScratchBase(Texel);
        uint RuleStart = 0u, Count = 0u;
        float Area = texelAreaScale(Texel);
        if (isValidTexel(Texel) && Area > 0.0)
        {
            uint Profile = TexelProfileIndices.Values[Texel];
            RuleStart = ReactionTable.Values[4u + Profile*4u];
            Count = ReactionTable.Values[5u + Profile*4u];
        }
        uint ReadPlane = 0u;
        vec4 Diagnostics = vec4(0.0); // substeps, supply-limited extents, budget exhausted, arithmetic failure
        bool HasContinuous = false;
        for (uint R = 0u; R < Count; ++R) HasContinuous = HasContinuous || ReactionTable.Values[RuleStart+R*16u] == 0u;
        float Remaining = max(Solver.DeltaTime, 0.0);
        // Inflow is a discrete operation, evaluated once before continuous integration.
        // Thereafter every local substep evaluates all rules from one immutable snapshot.
        for (uint Iteration = 0u; Iteration < 257u && Count > 0u; ++Iteration)
        {
            bool Inflow = Iteration == 0u;
            if (!Inflow && (Remaining <= 0.0 || !HasContinuous)) break;
            for (uint R = 0u; R < Count; ++R)
            {
                float Request = reactionRequest(RuleStart + R*16u, Base, ReadPlane, Area, Inflow);
                if (!solverFinite(Request)) { Diagnostics.w = 1.0; Request = 0.0; }
                ReactionScratch.Values[Base + 5u*K + R] = max(0.0,Request);
            }
            memoryBarrierBuffer();
            float Dt = Inflow ? 1.0 : min(Remaining, 1.0/240.0);
            for (uint C = 0u; C < K; ++C)
            {
                float Demand = 0.0;
                for (uint R = 0u; R < Count; ++R)
                    Demand += termCoefficient(RuleStart+R*16u, 8u, C) * ReactionScratch.Values[Base+5u*K+R];
                float Available = ReactionScratch.Values[Base + ReadPlane*K + C];
                if (!solverFinite(Demand)) Diagnostics.w = 1.0;
                // Keep ordinary continuous substeps below 10% depletion where possible.
                if (!Inflow && Demand > 0.0 && Available > 0.0) Dt = min(Dt, 0.1*Available/Demand);
                ReactionScratch.Values[Base+2u*K+C] = Demand;
            }
            // Always consume the entire caller's interval. The final bounded iteration
            // retains positivity through the common limiter, even for extremely stiff input.
            if (!Inflow && Iteration == 256u && Dt < Remaining) { Diagnostics.z = 1.0; Dt = Remaining; }
            if (!Inflow) Diagnostics.x += 1.0;
            for (uint C = 0u; C < K; ++C)
            {
                float Demand = ReactionScratch.Values[Base+2u*K+C] * Dt;
                float Available = ReactionScratch.Values[Base+ReadPlane*K+C];
                ReactionScratch.Values[Base+2u*K+C] = Demand > 0.0 ? min(1.0, Available/Demand) : 1.0;
            }
            memoryBarrierBuffer();
            for (uint R = 0u; R < Count; ++R)
            {
                uint Rule = RuleStart+R*16u;
                float Ratio = 1.0;
                uint Offset = ReactionTable.Values[Rule+8u];
                for (uint T = 0u; T < ReactionTable.Values[Rule+9u]; ++T)
                    Ratio = min(Ratio, ReactionScratch.Values[Base+2u*K+ReactionTable.Values[Offset+2u*T]]);
                if (Ratio < 1.0 && ReactionScratch.Values[Base+5u*K+R] > 0.0) Diagnostics.y += 1.0;
                ReactionScratch.Values[Base+5u*K+R] *= Dt * Ratio;
            }
            memoryBarrierBuffer();
            uint WritePlane = 1u-ReadPlane;
            bool FiniteStep = true;
            for (uint C = 0u; C < K; ++C)
            {
                float Delta = 0.0;
                for (uint R = 0u; R < Count; ++R)
                {
                    uint Rule = RuleStart+R*16u;
                    Delta += (termCoefficient(Rule, 10u, C)-termCoefficient(Rule, 8u, C)) * ReactionScratch.Values[Base+5u*K+R];
                }
                float NewValue = ReactionScratch.Values[Base+ReadPlane*K+C]+Delta;
                if (!solverFinite(NewValue)) { FiniteStep = false; Diagnostics.w = 1.0; }
                ReactionScratch.Values[Base+WritePlane*K+C] = max(0.0,NewValue);
            }
            memoryBarrierBuffer();
            if (FiniteStep) ReadPlane = WritePlane;
            if (!Inflow) Remaining = max(0.0, Remaining-Dt);
        }
        uint DiagnosticBase = Base + 5u*K + ReactionTable.Values[1];
        for (uint D = 0u; D < 4u; ++D) ReactionScratch.Values[DiagnosticBase+D] = Diagnostics[D];
        for (uint C = 0u; C < K; ++C)
        {
            float Old = CurrentState.Values[stateIndex(Texel, C)];
            float Value = ReactionScratch.Values[Base+ReadPlane*K+C];
            NextState.Values[stateIndex(Texel,C)] = Value;
            if (Old > 0.0 || Value > 0.0)
            { NeedsNext = true; if (C < 32u) Mask |= 1u << C; }
            if (accumulationContributionChanged(Texel,C,Old,Value)) scheduleAccumulationGroup(Group);
        }
    }
    if (Mask != 0u) atomicOr(GroupNextMask,Mask);
    if (NeedsNext) scheduleNextSolverTexel(Texel,Mask);
    barrier();
    if (gl_LocalInvocationIndex == 0u && GroupNextMask != 0u)
    {
        if (useActiveChannelMask()) atomicOr(AccumulationHeights.Values[solverNextMaskIndex()],GroupNextMask);
        if (usePerWorkgroupChannelMask()) atomicOr(AccumulationHeights.Values[solverNextWorkgroupMaskBase()+Group],GroupNextMask);
    }
}
