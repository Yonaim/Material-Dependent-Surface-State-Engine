// SurfaceSparseScheduleReset.comp — 다음 persistent Solver set과 Height/Geometry sparse schedule을 초기화하고 CPU input activation을 현재 set에 병합한다.
#version 450

const uint StateDrivenGeometryUpdateFlag = 1u << 6u;
const uint SparseGeometryFlag = 1u << 13u;
const uint SparseSolverFlag = 1u << 15u;
const uint SparseAccumulationHeightFlag = 1u << 16u;
const uint ActiveChannelMaskFlag = 1u << 17u;
const uint PrepareAccumulationHeightFlag = 1u << 18u;
const uint CurrentStateABFlag = 1u << 21u;
const uint PerWorkgroupChannelMaskFlag = 1u << 23u;

// ============================================================
// 00. Resource Interface
// ============================================================
// #region 00_Resource_Interface
// CPU가 전달하는 리소스 선언과 shader의 접근 경계를 모아 ABI 대응을 확인한다.

layout(std430, set = 0, binding = 21) buffer TSurfaceAccumulationData
{
    uint Values[];
}

AccumulationData;

layout(push_constant) uniform TSurfaceSolverPushConstants
{
    float DeltaTime;
    uint StateChannelCount;
    uint LocalTexelCount;
    uint Flags;
    vec4 GravityWorld;
    vec4 ModelLinearColumns[3];
    vec4 NormalMatrixAndUpColumns[3];
}

Solver;

layout(local_size_x = 64) in;

shared uint InputCount;
shared uint InputMask;

uint WorkgroupCount();
uint SolverBlockWords();
uint SolverACommandBase();
uint SolverBCommandBase();
uint SolverCommandBase(bool AB);
uint SolverFlagBase(bool AB);
uint SolverListBase(bool AB);
uint SolverMaskIndex(bool AB);
uint SolverWorkgroupMaskBase(bool AB);
bool CurrentAB();

uint InputCountIndex();
uint InputMaskIndex();
uint InputListBase();
uint InputGroupMaskBase();
uint AccumulationCommandBase();
uint AccumulationFlagBase();
uint AccumulationListBase();
uint GeometryCommandBase();
uint GeometryFlagBase();

void ResetCommand(uint Base);

void ScheduleCurrentSolverGroup(uint Group);

// #endregion

// ============================================================
// 01. Main Process
// ============================================================
// #region 01_Main_Process
// 다음 persistent Solver set과 Height/Geometry sparse schedule을 초기화하고 CPU input activation을 현재 set에 병합한다.

void ResetDestinationSchedules(uint Lane, uint Groups, bool Current, bool Next,
                               bool NeedSparseSolver, bool NeedActiveMask, bool NeedWorkgroupMask,
                               bool NeedSparseAccumulation, bool NeedGeometry, bool NeedSparseGeometry);
void MergeCPUContactActivity(uint Lane, uint Groups, bool Current, bool NeedWorkgroupMask);

void main()
{
    uint Lane = gl_LocalInvocationIndex;
    uint Groups = WorkgroupCount();
    bool Current = CurrentAB();
    bool Next = !Current;

    bool NeedSparseSolver = (Solver.Flags & SparseSolverFlag) != 0u;
    bool NeedActiveMask = (Solver.Flags & ActiveChannelMaskFlag) != 0u;
    bool NeedWorkgroupMask = (Solver.Flags & PerWorkgroupChannelMaskFlag) != 0u;
    bool NeedSparseAccumulation =
        (Solver.Flags & SparseAccumulationHeightFlag) != 0u && (Solver.Flags & PrepareAccumulationHeightFlag) != 0u;
    bool NeedGeometry = (Solver.Flags & StateDrivenGeometryUpdateFlag) != 0u;
    bool NeedSparseGeometry = NeedGeometry && (Solver.Flags & SparseGeometryFlag) != 0u;

    ResetDestinationSchedules(Lane, Groups, Current, Next, NeedSparseSolver,
                              NeedActiveMask, NeedWorkgroupMask, NeedSparseAccumulation,
                              NeedGeometry, NeedSparseGeometry);

    barrier();

    MergeCPUContactActivity(Lane, Groups, Current, NeedWorkgroupMask);

    barrier();

    if (Lane == 0u)
    {
        AccumulationData.Values[InputCountIndex()] = 0u;
        AccumulationData.Values[InputMaskIndex()] = 0u;
    }
}

// #endregion

// ============================================================
// 02. Detailed Implementation
// ============================================================
// #region 02_Detailed_Implementation
// 다음 persistent Solver set과 Height/Geometry sparse schedule을 초기화하고 CPU input activation을 현재 set에 병합한다.

void ResetDestinationSchedules(uint Lane, uint Groups, bool Current, bool Next,
                               bool NeedSparseSolver, bool NeedActiveMask, bool NeedWorkgroupMask,
                               bool NeedSparseAccumulation, bool NeedGeometry, bool NeedSparseGeometry)
{
    // 다음 세대 목록을 비우고 CPU 입력 활성 범위를 현재 실행에 합칠 준비를 한다.

    // Only metadata that will be consumed this step is cleared. The current persistent set must remain
    // valid for Pass1/Pass2, while the destination A/B set is prepared for Pass2's next-step handoff.
    for (uint Group = Lane; Group < Groups; Group += 64u)
    {
        if (NeedSparseSolver)
        {
            AccumulationData.Values[SolverFlagBase(Next) + Group] = 0u;
        }

        if (NeedWorkgroupMask)
        {
            AccumulationData.Values[SolverWorkgroupMaskBase(Next) + Group] = 0u;
        }

        if (NeedSparseAccumulation)
        {
            AccumulationData.Values[AccumulationFlagBase() + Group] = 0u;
        }

        if (NeedSparseGeometry)
        {
            AccumulationData.Values[GeometryFlagBase() + Group] = 0u;
        }
    }

    if (Lane == 0u)
    {
        if (NeedSparseSolver)
        {
            // Current command may be seeded from CPU input before it has ever served as a previous "next" set.
            AccumulationData.Values[SolverCommandBase(Current) + 1u] = 1u;
            AccumulationData.Values[SolverCommandBase(Current) + 2u] = 1u;
            ResetCommand(SolverCommandBase(Next));
        }

        if (NeedActiveMask)
        {
            AccumulationData.Values[SolverMaskIndex(Next)] = 0u;
        }

        if (NeedSparseAccumulation)
        {
            ResetCommand(AccumulationCommandBase());
        }

        if (NeedGeometry)
        {
            ResetCommand(GeometryCommandBase());
        }

        InputCount = min(AccumulationData.Values[InputCountIndex()], Groups);
        InputMask = AccumulationData.Values[InputMaskIndex()];
    }


}

void MergeCPUContactActivity(uint Lane, uint Groups, bool Current, bool NeedWorkgroupMask)
{
    // 접촉 입력이 있는 workgroup을 활성 목록에 합쳐 빈 State에서도 입력을 처리한다.

    // CPU contact distribution already knows the touched groups; merge only those instead of scanning every texel.
    for (uint Index = Lane; Index < InputCount; Index += 64u)
    {
        uint Group = AccumulationData.Values[InputListBase() + Index];
        ScheduleCurrentSolverGroup(Group);

        if (NeedWorkgroupMask && Group < Groups)
        {
            atomicOr(AccumulationData.Values[SolverWorkgroupMaskBase(Current) + Group],
                     AccumulationData.Values[InputGroupMaskBase() + Index]);
        }
    }

    if (Lane == 0u && (Solver.Flags & ActiveChannelMaskFlag) != 0u)
    {
        atomicOr(AccumulationData.Values[SolverMaskIndex(Current)], InputMask);
    }


}

    // 02.00. Solver Schedule Address Layout
    // #region 02_00_Solver_Schedule_Address_Layout
    // workgroup 목록·마스크·indirect 명령의 uint-word 주소를 계산한다.

    uint WorkgroupCount()
    {
        return (Solver.LocalTexelCount + 63u) / 64u;
    }

    uint SolverBlockWords()
    {
        return WorkgroupCount() * 3u + 4u;
    }

    uint SolverACommandBase()
    {
        return 3u * Solver.LocalTexelCount;
    }

    uint SolverBCommandBase()
    {
        return SolverACommandBase() + SolverBlockWords();
    }

    uint SolverCommandBase(bool AB)
    {
        return AB ? SolverACommandBase() : SolverBCommandBase();
    }

    uint SolverFlagBase(bool AB)
    {
        return SolverCommandBase(AB) + 3u;
    }

    uint SolverListBase(bool AB)
    {
        return SolverFlagBase(AB) + WorkgroupCount();
    }

    uint SolverMaskIndex(bool AB)
    {
        return SolverListBase(AB) + WorkgroupCount();
    }

    uint SolverWorkgroupMaskBase(bool AB)
    {
        return SolverMaskIndex(AB) + 1u;
    }

    bool CurrentAB()
    {
        return (Solver.Flags & CurrentStateABFlag) != 0u;
    }

    // #endregion

    // 02.01. CPU Input Activation Layout
    // #region 02_01_CPU_Input_Activation_Layout
    // CPU가 올린 접촉 활성 정보의 주소를 Solver가 읽을 위치로 환산한다.

    uint InputCountIndex()
    {
        return SolverBCommandBase() + SolverBlockWords();
    }

    uint InputMaskIndex()
    {
        return InputCountIndex() + 1u;
    }

    uint InputListBase()
    {
        return InputMaskIndex() + 1u;
    }

    uint InputGroupMaskBase()
    {
        return InputListBase() + WorkgroupCount();
    }

    // #endregion

    // 02.02. Accumulation and Geometry Schedule Layout
    // #region 02_02_Accumulation_and_Geometry_Schedule_Layout
    // 높이·형상 갱신 목록과 간접 dispatch 자료가 같은 allocation을 공유한다.

    uint AccumulationCommandBase()
    {
        return InputGroupMaskBase() + WorkgroupCount();
    }

    uint AccumulationFlagBase()
    {
        return AccumulationCommandBase() + 3u;
    }

    uint AccumulationListBase()
    {
        return AccumulationFlagBase() + WorkgroupCount();
    }

    uint GeometryCommandBase()
    {
        return AccumulationListBase() + WorkgroupCount();
    }

    uint GeometryFlagBase()
    {
        return GeometryCommandBase() + 3u;
    }

    // #endregion

    // 02.03. Reset Commands and Append Current Workgroups
    // #region 02_03_Reset_Commands_and_Append_Current_Workgroups
    // 계산 결과를 AccumulationData 버퍼에 기록해 후속 GPU 단계에 전달한다.

    void ResetCommand(uint Base)
    {
        AccumulationData.Values[Base] = 0u;
        AccumulationData.Values[Base + 1u] = 1u;
        AccumulationData.Values[Base + 2u] = 1u;
    }

    void ScheduleCurrentSolverGroup(uint Group)
    {
        if ((Solver.Flags & SparseSolverFlag) == 0u || Group >= WorkgroupCount())
        {
            return;
        }

        bool AB = CurrentAB();

        if (atomicCompSwap(AccumulationData.Values[SolverFlagBase(AB) + Group], 0u, 1u) == 0u)
        {
            uint Slot = atomicAdd(AccumulationData.Values[SolverCommandBase(AB)], 1u);

            if (Slot < WorkgroupCount())
            {
                AccumulationData.Values[SolverListBase(AB) + Slot] = Group;
            }
        }
    }

    // #endregion

// #endregion
