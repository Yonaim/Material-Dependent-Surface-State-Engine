# 표면의 상태, 입력 필드 및 계산 규칙을 연결한다.
version: 1
id: ShallowSpongeAbsorptionSample
# 표면을 받치는 재질의 ID. Materials에서 물성과 바탕 외관을 읽는다.
substrate: Sponge
# 표면의 저장 칸을 정의한다. material과 phase는 Materials의 물성을 참조한다.
states:
  # 표면 위에 놓인 상태. 질량은 kg으로 저장하고 표시 범위는 kg/m² 또는 mm로 지정한다.
  layer:
    - id: SurfaceWater
      quantity: mass
      unit: kg
      material: Water
      phase: liquid
      displayName: Surface water
      displayMax: 1.0
      thicknessDisplayMaxMm: 4.0
  # 바탕에 남는 상태. 온도는 K, 흡수수는 kg, 탄화율은 0~1로 선언한다.
  substrate:
    - id: AbsorbedWater
      quantity: mass
      unit: kg
      material: Water
      phase: liquid
      displayName: Absorbed water
      displayMax: 0.625
# 상태 ID별 저장 상한 또는 유효 깊이. capacityKgM2는 면적당 질량 한도다.
substrateStorage:
  AbsorbedWater:
    # 같은 재질에서 유효 깊이를 25 mm에서 5 mm로 줄인 비교 조건이다.
    capacityKgM2: 0.5
# 층 순서는 아래에서 위다. state는 급수와 기본 수심 표시가 사용하는 액체다.
transport:
  state: SurfaceWater
# use에 공유 규칙 ID를 쓰고 from, to, inputs 등으로 이 프로파일의 상태와 필드에 연결한다.
interactions:
  - use: SurfaceAbsorption
    from: SurfaceWater
    to: AbsorbedWater
# 렌더링에서 사용하는 외관 값과 표시할 상태의 연결이다.
appearance:
  liquidCoverageDepthMeters: 0.00016
  liquidOpticalDepthScale: 2.5
  wetCloth:
    state: AbsorbedWater
    # 5 mm 몸체가 가득 젖었을 때의 면밀도다.
    referenceKgM2: 0.5
