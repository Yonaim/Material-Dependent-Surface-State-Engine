# 씬의 절차가 계산하는 상태의 저장 위치와 표시 범위를 선언한다.
version: 1
id: SteelWithWaterAndSnow
substrate: Steel
appearance:
  snow:
    state: Snow
    bulkDensityKgM3: 250
    maps:
      colorTexture: AmbientCG/Snow003.png
      normalTexture: AmbientCG/Snow003Normal.png
      tileMeters: 0.055
# 표면의 저장 칸을 정의한다. material과 phase는 Materials의 물성을 참조한다.
states:
  # 표면 위에 놓인 상태. 질량은 kg으로 저장하고 표시 범위는 kg/m² 또는 mm로 지정한다.
  layer:
    - id: SurfaceWater
      quantity: mass
      unit: kg
      material: Water
      phase: liquid
      displayName: Surface water
      displayMax: 1.0
      thicknessDisplayMaxMm: 4.0
    - id: Snow
      quantity: mass
      unit: kg
      material: Water
      phase: snow
      displayName: Snow
      displayMax: 6.3
      thicknessDisplayMaxMm: 26.0
  # 바탕에 남는 상태. 온도는 K, 흡수수는 kg, 탄화율은 0~1로 선언한다.
  substrate:
    - id: SubstrateTemperature
      quantity: temperature
      unit: K
      source: temperature
      displayName: Substrate temperature
      displayMax: 1500
# use에 공유 규칙 ID를 쓰고 from, to, inputs 등으로 이 프로파일의 상태와 필드에 연결한다.
interactions: []
